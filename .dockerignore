1_random_dump
prospect_research
whatsapp_receiver
packages
zoho_sent

# Docker files (no need to send back into the build context)
Dockerfile
.dockerignore
docker-compose.yml

# IDE / OS
.vscode
.idea
**/__pycache__
**/.env.local
