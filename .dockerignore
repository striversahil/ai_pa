# Frontend — exclude node_modules and build artifacts
founder-os_frontend/node_modules
founder-os_frontend/.next
founder-os_frontend/out

# Backend — exclude node_modules, compiled output, TS cache, and generated public dir
founder-os_backend/node_modules
founder-os_backend/dist
founder-os_backend/.tscache
founder-os_backend/public

# Git and editor files
.git
.gitignore
**/.DS_Store
**/*.log
**/*.md

