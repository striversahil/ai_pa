// ═════════════════════════════════════════════════════════════════════════════
//  automation.prisma — AUTOMATION & DASHBOARD LAYER  ·  ✏️ AI-EDITABLE
// ═════════════════════════════════════════════════════════════════════════════
//  AI coding agents MAY add, change and remove models in this file to build
//  dashboards, reports, automations, AI features and experiments.
//
//  Rules (checked by scripts/schema-guard.mjs — a violation fails CI):
//    1. Every model and enum here uses @@schema("automation").
//    2. No relation fields pointing at core models. Reference core records
//       with a plain id column instead, e.g.
//          customerId String @db.Uuid   // → core.Customer (soft reference)
//       Name soft-reference columns after the core model they point at.
//    3. Never store a copy of core business facts (amounts, stages, stock,
//       prices) as the source of truth. Cache them only in clearly named
//       snapshot/derived tables that can be rebuilt from core.
//    4. To change core data at runtime, call the core service layer (it
//       checks permissions, writes the audit trail and emits DomainEvents).
//       Never write core tables directly.
//    5. React to core changes by consuming core.DomainEvent through
//       EventConsumerCursor — do not poll business tables.
//    6. Every table here is audited automatically: the event trigger in
//       prisma/sql/core attaches the row-change trigger to any new table
//       created in the "automation" schema.
// ═════════════════════════════════════════════════════════════════════════════

enum AutomationTriggerType {
  DOMAIN_EVENT // fires on core.DomainEvent.eventType
  SCHEDULE // cron
  MANUAL
  @@schema("automation")
}

enum RunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
  CANCELLED
  @@schema("automation")
}

enum InsightStatus {
  NEW
  ACCEPTED
  DISMISSED
  EXPIRED
  @@schema("automation")
}

enum CustomFieldType {
  TEXT
  NUMBER
  DECIMAL
  BOOLEAN
  DATE
  SELECT
  MULTI_SELECT
  JSON
  @@schema("automation")
}

// ── Event consumption ────────────────────────────────────────────────────────

// Where each consumer is in the core.DomainEvent stream (by sequence).
model EventConsumerCursor {
  consumerKey  String   @id // automation-engine | notification-fanout | mis-refresh
  lastSequence BigInt   @default(0)
  lastError    String?
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  @@schema("automation")
}

// ── Rule automations ─────────────────────────────────────────────────────────

model AutomationRule {
  id             String                @id @default(uuid(7)) @db.Uuid
  key            String                @unique
  name           String
  description    String?
  triggerType    AutomationTriggerType
  eventTypes     String[] @default([]) // for DOMAIN_EVENT, e.g. ["sales_order.stage_changed"]
  cron           String? // for SCHEDULE (Asia/Kolkata)
  conditions     Json? // evaluated against the event payload
  steps          Json // ordered core-service calls, e.g. create_action, notify, request_approval
  enabled        Boolean               @default(false)
  cooldownSec    Int                   @default(0)
  version        Int                   @default(1)
  ownerEmployeeId String?              @db.Uuid // → core.Employee
  createdByAgent String? // which coding agent / session added it
  lastRunAt      DateTime?             @db.Timestamptz(3)
  createdAt      DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime              @updatedAt @db.Timestamptz(3)

  runs AutomationRuleRun[]

  @@index([enabled, triggerType])
  @@schema("automation")
}

model AutomationRuleRun {
  id              String         @id @default(uuid(7)) @db.Uuid
  ruleId          String         @db.Uuid
  rule            AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  dedupKey        String // event sequence or schedule slot — never fires twice
  status          RunStatus      @default(QUEUED)
  eventSequence   BigInt? // → core.DomainEvent.sequence
  input           Json?
  output          Json?
  coreRequestIds  String[] @default([]) // ids returned by the core service for what it created
  error           String?
  startedAt       DateTime       @default(now()) @db.Timestamptz(3)
  finishedAt      DateTime?      @db.Timestamptz(3)

  @@unique([ruleId, dedupKey])
  @@index([status, startedAt])
  @@schema("automation")
}

// ── AI agents (runtime) ──────────────────────────────────────────────────────

model AgentDefinition {
  id           String   @id @default(uuid(7)) @db.Uuid
  key          String   @unique // rate-finder | estimate-classifier | enquiry-intake | collections-coach
  name         String
  description  String?
  model        String
  promptKey    String? // → PromptTemplate.key
  tools        Json // core-service tools the agent may call
  serviceAccountKey String // → core.ServiceAccount.key it runs as (its permissions)
  enabled      Boolean  @default(false)
  config       Json?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  runs AgentRun[]

  @@schema("automation")
}

model AgentRun {
  id            String          @id @default(uuid(7)) @db.Uuid
  agentId       String          @db.Uuid
  agent         AgentDefinition @relation(fields: [agentId], references: [id], onDelete: Restrict)
  triggeredBy   String // employee:<id> | rule:<key> | schedule
  entityType    String?
  entityId      String?         @db.Uuid // → core record it worked on
  status        RunStatus       @default(QUEUED)
  input         Json?
  output        Json?
  inputTokens   Int?
  outputTokens  Int?
  costInr       Decimal?        @db.Decimal(12, 4)
  error         String?
  startedAt     DateTime        @default(now()) @db.Timestamptz(3)
  finishedAt    DateTime?       @db.Timestamptz(3)

  toolCalls AgentToolCall[]
  insights  AiInsight[]

  @@index([agentId, startedAt])
  @@index([entityType, entityId])
  @@schema("automation")
}

model AgentToolCall {
  id         String    @id @default(uuid(7)) @db.Uuid
  runId      String    @db.Uuid
  run        AgentRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  seq        Int
  toolName   String
  input      Json?
  output     Json?
  status     RunStatus @default(SUCCEEDED)
  durationMs Int?
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  @@unique([runId, seq])
  @@schema("automation")
}

model PromptTemplate {
  id        String   @id @default(uuid(7)) @db.Uuid
  key       String
  version   Int      @default(1)
  body      String
  variables String[] @default([])
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([key, version])
  @@schema("automation")
}

// AI output attached to a core record: estimate intent score, follow-up
// quality, churn risk, recommended next step. Advisory only — it never
// changes core data by itself.
model AiInsight {
  id         String        @id @default(uuid(7)) @db.Uuid
  kind       String // estimate_intent | followup_quality | churn_risk | next_best_action
  entityType String
  entityId   String        @db.Uuid
  title      String
  body       String?
  score      Decimal?      @db.Decimal(7, 4)
  data       Json?
  status     InsightStatus @default(NEW)
  runId      String?       @db.Uuid
  run        AgentRun?     @relation(fields: [runId], references: [id], onDelete: SetNull)
  expiresAt  DateTime?     @db.Timestamptz(3)
  createdAt  DateTime      @default(now()) @db.Timestamptz(3)

  @@index([entityType, entityId, kind])
  @@index([kind, status])
  @@schema("automation")
}

// ── Dashboards & reports ─────────────────────────────────────────────────────
// Who may open a dashboard is decided by core permissions
// (requiredScreenKey → core PermissionRule entityType "screen:<key>").

model DashboardDefinition {
  id                String   @id @default(uuid(7)) @db.Uuid
  key               String   @unique // sales_my_work | sales_tl_team | accounts_verification | dispatch_board | founder_os
  name              String
  description       String?
  requiredScreenKey String
  layout            Json?
  isDefaultFor      String[] @default([]) // core Position codes that land here after login
  active            Boolean  @default(true)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  widgets DashboardWidget[]

  @@schema("automation")
}

model DashboardWidget {
  id          String              @id @default(uuid(7)) @db.Uuid
  dashboardId String              @db.Uuid
  dashboard   DashboardDefinition @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  key         String
  type        String // kpi | table | chart | kanban | list | timeline
  title       String
  dataSource  String // a core read endpoint / report key — data is always read through core permissions
  config      Json?
  position    Json? // grid placement
  sortOrder   Int                 @default(0)

  @@unique([dashboardId, key])
  @@schema("automation")
}

model SavedView {
  id         String   @id @default(uuid(7)) @db.Uuid
  employeeId String   @db.Uuid // → core.Employee (owner)
  entityType String
  name       String
  filters    Json?
  columns    Json?
  sort       Json?
  isShared   Boolean  @default(false)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([employeeId, entityType])
  @@schema("automation")
}

model UiPreference {
  employeeId String   @db.Uuid // → core.Employee
  key        String
  value      Json
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@id([employeeId, key])
  @@schema("automation")
}

model ReportDefinition {
  id                String   @id @default(uuid(7)) @db.Uuid
  key               String   @unique // conversion_by_region | overdue_followups | ageing_by_region | dispatch_otif
  name              String
  description       String?
  requiredScreenKey String
  query             Json // declarative query over core read models
  parameters        Json?
  active            Boolean  @default(true)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  snapshots ReportSnapshot[]

  @@schema("automation")
}

// Cached report results — always rebuildable from core; never authoritative.
model ReportSnapshot {
  id          String           @id @default(uuid(7)) @db.Uuid
  reportId    String           @db.Uuid
  report      ReportDefinition @relation(fields: [reportId], references: [id], onDelete: Cascade)
  paramsHash  String
  data        Json
  computedAt  DateTime         @default(now()) @db.Timestamptz(3)
  expiresAt   DateTime?        @db.Timestamptz(3)

  @@index([reportId, paramsHash, computedAt])
  @@schema("automation")
}

// Data Explorer registry: how to search/list/open each core entity.
model ExplorerEntityConfig {
  entityType   String   @id
  label        String
  searchFields String[] @default([])
  listColumns  Json
  filters      Json
  relations    Json?
  detailRoute  String?
  active       Boolean  @default(true)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  @@schema("automation")
}

// ── Extending core records without editing core ──────────────────────────────
// A new field a dashboard needs on a core entity is added here as a custom
// field. If it later becomes business-critical, promote it into core.prisma
// through the human review process.

model CustomFieldDefinition {
  id         String          @id @default(uuid(7)) @db.Uuid
  entityType String // core model name
  key        String
  label      String
  type       CustomFieldType
  options    Json?
  validation Json?
  active     Boolean         @default(true)
  createdAt  DateTime        @default(now()) @db.Timestamptz(3)

  values CustomFieldValue[]

  @@unique([entityType, key])
  @@schema("automation")
}

model CustomFieldValue {
  id           String                @id @default(uuid(7)) @db.Uuid
  definitionId String                @db.Uuid
  definition   CustomFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Restrict)
  entityId     String                @db.Uuid // → the core record
  value        Json
  updatedAt    DateTime              @updatedAt @db.Timestamptz(3)

  @@unique([definitionId, entityId])
  @@index([entityId])
  @@schema("automation")
}

model FeatureFlag {
  key         String   @id
  description String?
  enabled     Boolean  @default(false)
  rules       Json? // e.g. enable for Position codes / employee ids
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@schema("automation")
}
