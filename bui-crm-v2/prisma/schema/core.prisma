// ═════════════════════════════════════════════════════════════════════════════
// 1. PLATFORM: legal entities, fiscal calendar, numbering, files, references,
//    domain events
// ═════════════════════════════════════════════════════════════════════════════

// A GST-registered business that issues documents (BUI, DPG). Each GSTIN is
// its own legal entity: separate numbering, ledgers and returns.
model LegalEntity {
  id             String   @id @default(uuid(7)) @db.Uuid
  code           String   @unique // BUI | DPG
  legalName      String
  tradeName      String?
  gstin          String?  @unique
  pan            String?
  cin            String?
  stateCode      String // GST state code of registration, e.g. "23"
  addressLine1   String
  addressLine2   String?
  city           String
  pincode        String
  email          String?
  phone          String?
  logoStorageKey String?
  eInvoiceEnabled Boolean @default(false) // turnover-based applicability
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  fiscalYears       FiscalYear[]
  periods           AccountingPeriod[]
  documentSeries    DocumentSeries[]
  warehouses        Warehouse[]
  bankAccounts      BankAccount[]
  ledgerAccounts    LedgerAccount[]
  journalEntries    JournalEntry[]
  enquiries         SalesEnquiry[]
  estimates         SalesEstimate[]
  salesOrders       SalesOrder[]
  dispatches        Dispatch[]
  invoices          Invoice[]
  adjustmentNotes   AdjustmentNote[]
  receipts          PaymentReceipt[]
  purchaseOrders    PurchaseOrder[]
  goodsReceipts     GoodsReceipt[]
  supplierBills     SupplierBill[]
  supplierPayments  SupplierPayment[]
  gstReturnFilings  GstReturnFiling[]

  @@schema("core")
}

model FiscalYear {
  id            String      @id @default(uuid(7)) @db.Uuid
  legalEntityId String      @db.Uuid
  legalEntity   LegalEntity @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  code          String // "2026-27"
  startDate     DateTime    @db.Date
  endDate       DateTime    @db.Date
  isClosed      Boolean     @default(false)
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)

  periods        AccountingPeriod[]
  documentSeries DocumentSeries[]

  @@unique([legalEntityId, code])
  @@schema("core")
}

// Monthly posting periods. Nothing can be posted into a CLOSED/LOCKED period
// (enforced by trigger).
model AccountingPeriod {
  id            String       @id @default(uuid(7)) @db.Uuid
  legalEntityId String       @db.Uuid
  legalEntity   LegalEntity  @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  fiscalYearId  String       @db.Uuid
  fiscalYear    FiscalYear   @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)
  startDate     DateTime     @db.Date
  endDate       DateTime     @db.Date
  status        PeriodStatus @default(OPEN)
  closedAt      DateTime?    @db.Timestamptz(3)

  @@unique([legalEntityId, startDate])
  @@schema("core")
}

// Gapless document numbering per legal entity, document type and fiscal
// year (GST: unique, consecutive, max 16 characters per FY). Numbers are
// issued only by core.next_document_number() inside the creating transaction.
model DocumentSeries {
  id            String       @id @default(uuid(7)) @db.Uuid
  legalEntityId String       @db.Uuid
  legalEntity   LegalEntity  @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  documentType  DocumentType
  fiscalYearId  String       @db.Uuid
  fiscalYear    FiscalYear   @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)
  prefix        String // "BUI/26-27/INV/" — total length checked against 16 for GST docs
  nextNumber    Int          @default(1)
  padding       Int          @default(5)
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @db.Timestamptz(3)

  @@unique([legalEntityId, documentType, fiscalYearId])
  @@schema("core")
}

// One table for every uploaded file (replaces seven legacy attachment
// tables). Bytes live in object storage / Workers KV; this is the metadata.
model Attachment {
  id         String    @id @default(uuid(7)) @db.Uuid
  entityType String // SalesOrder | Dispatch | Invoice | Customer | SupplierRate ...
  entityId   String    @db.Uuid
  kind       String // invoice_pdf | pod | packing_before | packing_after | lr_copy | eway_bill | po_copy | quote | photo | other
  fileName   String
  mimeType   String
  sizeBytes  Int
  storageKey String    @unique
  sha256     String
  deletedAt  DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  @@index([entityType, entityId])
  @@index([sha256])
  @@schema("core")
}

// Ids of core records in other systems: Zoho history, legacy BUI tables,
// NeoDove, WhatsApp, the GST portals. One place to answer "what was this
// called before / elsewhere".
model ExternalReference {
  id         String         @id @default(uuid(7)) @db.Uuid
  system     ExternalSystem
  namespace  String         @default("") // Zoho org id, legacy table name, ...
  externalId String
  entityType String
  entityId   String         @db.Uuid
  importedAt DateTime       @default(now()) @db.Timestamptz(3)
  metadata   Json?

  @@unique([system, namespace, externalId, entityType])
  @@index([entityType, entityId])
  @@schema("core")
}

// Transactional outbox: every meaningful core change appends one event in the
// same transaction. Automations, notifications and integrations consume this
// stream in order (sequence) instead of polling business tables.
model DomainEvent {
  sequence      BigInt    @id @default(autoincrement())
  eventType     String // sales_order.stage_changed | invoice.issued | action.overdue ...
  entityType    String
  entityId      String    @db.Uuid
  payload       Json
  actorType     ActorType
  actorId       String?   @db.Uuid
  correlationId String?
  occurredAt    DateTime  @default(now()) @db.Timestamptz(3)

  @@index([eventType, sequence])
  @@index([entityType, entityId])
  @@schema("core")
}

// ═════════════════════════════════════════════════════════════════════════════
// 2. ORGANISATION & IDENTITY
// ═════════════════════════════════════════════════════════════════════════════

model Employee {
  id             String         @id @default(uuid(7)) @db.Uuid
  employeeCode   String?        @unique
  fullName       String
  displayName    String?
  workEmail      String?        @unique
  phoneE164      String?
  whatsappE164   String?
  status         EmployeeStatus @default(ACTIVE)
  employmentType String?
  joiningDate    DateTime?      @db.Date
  exitDate       DateTime?      @db.Date
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)

  userAccount UserAccount?

  departmentAssignments EmployeeDepartmentAssignment[]
  positionAssignments   EmployeePositionAssignment[]
  regionAssignments     EmployeeRegionAssignment[]
  teamMemberships       TeamMembership[]
  reportingLines        EmployeeReportingLine[]        @relation("ReportingEmployee")
  directReports         EmployeeReportingLine[]        @relation("ReportingManager")
  roles                 EmployeeRole[]

  customerAssignments   CustomerAssignment[] @relation("CustomerAssignee")
  customerAssignmentsMade CustomerAssignment[] @relation("CustomerAssignedBy")
  customerActivities    CustomerActivity[]
  customerNotes         CustomerNote[]

  enquiriesOwned        SalesEnquiry[]            @relation("EnquiryOwner")
  enquiriesGenerated    SalesEnquiry[]            @relation("EnquiryGenerator")
  enquiriesQualified    SalesEnquiry[]            @relation("EnquiryQualifier")
  estimatesOwned        SalesEstimate[]
  estimateAssignments   SalesEstimateAssignment[] @relation("EstimateHolder")
  estimateCovers        SalesEstimateAssignment[] @relation("EstimateCoverFor")
  salesOrdersOwned      SalesOrder[]
  stageEvents           SalesOrderStageEvent[]
  salesCredits          SalesCredit[]
  receiptsVerified      PaymentReceipt[]
  paymentPromises       PaymentPromise[]

  actionsAssigned       BusinessAction[]      @relation("ActionAssignee")
  actionsCreated        BusinessAction[]      @relation("ActionCreator")
  actionsCompleted      BusinessAction[]      @relation("ActionCompleter")
  actionEvents          BusinessActionEvent[]
  escalationSteps       EscalationStep[]
  approvalStages        ApprovalPolicyStage[]
  approvalsRequested    ApprovalRequest[]     @relation("ApprovalRequester")
  approvalsAwaiting     ApprovalRequest[]     @relation("ApprovalCurrentApprover")
  approvalEvents        ApprovalEvent[]
  notifications         Notification[]
  notificationPrefs     NotificationPreference[]
  dataIssuesAssigned    DataQualityIssue[]    @relation("IssueAssignee")
  dataIssuesResolved    DataQualityIssue[]    @relation("IssueResolver")
  integrationCommands   IntegrationCommand[]

  @@index([status])
  @@index([fullName])
  @@schema("core")
}

model Department {
  id        String       @id @default(uuid(7)) @db.Uuid
  code      String       @unique // MANAGEMENT | SALES | CRM | ACCOUNTS | PURCHASE | INVENTORY | DISPATCH | HR | MARKETING
  name      String
  parentId  String?      @db.Uuid
  parent    Department?  @relation("DepartmentTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  Department[] @relation("DepartmentTree")
  active    Boolean      @default(true)
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @db.Timestamptz(3)

  positions           Position[]
  teams               Team[]
  employeeAssignments EmployeeDepartmentAssignment[]
  actions             BusinessAction[]
  escalationPolicies  EscalationPolicy[]
  approvalRequests    ApprovalRequest[]

  @@schema("core")
}

model Position {
  id           String      @id @default(uuid(7)) @db.Uuid
  code         String      @unique // FOUNDER | SALES_HEAD | TL1 | TL2 | TELECALLER | FIELD_EXEC | ACCOUNTS_HEAD | ACCOUNTANT | STORE_KEEPER | DISPATCH_EXEC ...
  name         String
  departmentId String?     @db.Uuid
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  rank         Int         @default(100) // lower = more senior
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime    @updatedAt @db.Timestamptz(3)

  assignments     EmployeePositionAssignment[]
  roles           PositionRole[]
  actions         BusinessAction[]
  escalationSteps EscalationStep[]
  approvalStages  ApprovalPolicyStage[]

  @@schema("core")
}

model Team {
  id           String     @id @default(uuid(7)) @db.Uuid
  code         String     @unique
  name         String
  departmentId String     @db.Uuid
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  regionId     String?    @db.Uuid
  region       Region?    @relation(fields: [regionId], references: [id], onDelete: Restrict)
  parentId     String?    @db.Uuid
  parent       Team?      @relation("TeamTree", fields: [parentId], references: [id], onDelete: Restrict)
  children     Team[]     @relation("TeamTree")
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(3)

  memberships         TeamMembership[]
  customerAssignments CustomerAssignment[]
  actions             BusinessAction[]

  @@index([departmentId])
  @@schema("core")
}

model Region {
  id        String   @id @default(uuid(7)) @db.Uuid
  code      String   @unique // R1 | R2 | R3 | R4
  name      String
  states    String[] @default([]) // GST state codes covered — routes new customers/enquiries
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  employeeAssignments EmployeeRegionAssignment[]
  teams               Team[]
  customerAssignments CustomerAssignment[]
  enquiries           SalesEnquiry[]
  estimates           SalesEstimate[]
  salesOrders         SalesOrder[]
  invoices            Invoice[]

  @@schema("core")
}

model EmployeeDepartmentAssignment {
  id           String     @id @default(uuid(7)) @db.Uuid
  employeeId   String     @db.Uuid
  employee     Employee   @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  departmentId String     @db.Uuid
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  isPrimary    Boolean    @default(true)
  validFrom    DateTime   @default(now()) @db.Timestamptz(3)
  validTo      DateTime?  @db.Timestamptz(3)
  reason       String?

  @@index([employeeId, validTo])
  @@index([departmentId, validTo])
  @@schema("core")
}

model EmployeePositionAssignment {
  id         String    @id @default(uuid(7)) @db.Uuid
  employeeId String    @db.Uuid
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  positionId String    @db.Uuid
  position   Position  @relation(fields: [positionId], references: [id], onDelete: Restrict)
  isPrimary  Boolean   @default(true)
  validFrom  DateTime  @default(now()) @db.Timestamptz(3)
  validTo    DateTime? @db.Timestamptz(3)
  reason     String?

  @@index([employeeId, validTo])
  @@index([positionId, validTo])
  @@schema("core")
}

model EmployeeRegionAssignment {
  id             String               @id @default(uuid(7)) @db.Uuid
  employeeId     String               @db.Uuid
  employee       Employee             @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  regionId       String               @db.Uuid
  region         Region               @relation(fields: [regionId], references: [id], onDelete: Restrict)
  responsibility RegionResponsibility @default(PRIMARY)
  validFrom      DateTime             @default(now()) @db.Timestamptz(3)
  validTo        DateTime?            @db.Timestamptz(3)
  reason         String?

  @@index([employeeId, validTo])
  @@index([regionId, validTo])
  @@schema("core")
}

model TeamMembership {
  id         String    @id @default(uuid(7)) @db.Uuid
  teamId     String    @db.Uuid
  team       Team      @relation(fields: [teamId], references: [id], onDelete: Restrict)
  employeeId String    @db.Uuid
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  role       TeamRole  @default(MEMBER)
  validFrom  DateTime  @default(now()) @db.Timestamptz(3)
  validTo    DateTime? @db.Timestamptz(3)

  @@index([teamId, validTo])
  @@index([employeeId, validTo])
  @@schema("core")
}

model EmployeeReportingLine {
  id         String            @id @default(uuid(7)) @db.Uuid
  employeeId String            @db.Uuid
  employee   Employee          @relation("ReportingEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  managerId  String            @db.Uuid
  manager    Employee          @relation("ReportingManager", fields: [managerId], references: [id], onDelete: Restrict)
  type       ReportingLineType @default(DIRECT)
  validFrom  DateTime          @default(now()) @db.Timestamptz(3)
  validTo    DateTime?         @db.Timestamptz(3)

  @@index([employeeId, validTo])
  @@index([managerId, validTo])
  @@schema("core")
}

// Dashboard login. One per employee. The core service layer is the only thing
// that reads/writes business tables; the dashboard holds a session token.
model UserAccount {
  id              String        @id @default(uuid(7)) @db.Uuid
  employeeId      String        @unique @db.Uuid
  employee        Employee      @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  email           String        @unique
  authProvider    String        @default("google")
  providerSubject String?       @unique // OAuth "sub"
  status          AccountStatus @default(ACTIVE)
  isSuperAdmin    Boolean       @default(false) // still fully audited
  mfaEnabled      Boolean       @default(false)
  lastLoginAt     DateTime?     @db.Timestamptz(3)
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(3)

  sessions UserSession[]

  @@schema("core")
}

model UserSession {
  id            String      @id @default(uuid(7)) @db.Uuid
  userAccountId String      @db.Uuid
  userAccount   UserAccount @relation(fields: [userAccountId], references: [id], onDelete: Restrict)
  tokenHash     String      @unique // never the raw token
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)
  lastSeenAt    DateTime?   @db.Timestamptz(3)
  expiresAt     DateTime    @db.Timestamptz(3)
  revokedAt     DateTime?   @db.Timestamptz(3)

  @@index([userAccountId, expiresAt])
  @@schema("core")
}

// Machine identities: n8n, the AI rate engine, AI agents at runtime, the GSP
// connector, NeoDove sync. Each has its own key and roles, so every change is
// attributable to exactly one system.
model ServiceAccount {
  id          String    @id @default(uuid(7)) @db.Uuid
  key         String    @unique // n8n | ai-rate-engine | agent-runtime | gsp-connector | neodove-sync
  name        String
  description String?
  apiKeyHash  String    @unique
  active      Boolean   @default(true)
  lastUsedAt  DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  roles ServiceAccountRole[]

  @@schema("core")
}

// ═════════════════════════════════════════════════════════════════════════════
// 3. ACCESS CONTROL (enforced in the core service layer, never in the UI)
// ═════════════════════════════════════════════════════════════════════════════
// Effective permissions of an employee =
//   rules of the roles attached to their current positions (PositionRole)
//   ∪ rules of roles granted to them directly (EmployeeRole)
// Dashboard screens are permission subjects too: entityType = "screen:<key>".

model Role {
  id          String   @id @default(uuid(7)) @db.Uuid
  key         String   @unique // sales_staff | sales_tl | sales_head | accounts | store | dispatch | founder ...
  name        String
  description String?
  isSystem    Boolean  @default(false) // seeded roles cannot be deleted
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  rules           PermissionRule[]
  positions       PositionRole[]
  employees       EmployeeRole[]
  serviceAccounts ServiceAccountRole[]
  approvalStages  ApprovalPolicyStage[]
  stageGates      StageGateRule[]

  @@schema("core")
}

model PositionRole {
  positionId String   @db.Uuid
  position   Position @relation(fields: [positionId], references: [id], onDelete: Restrict)
  roleId     String   @db.Uuid
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@id([positionId, roleId])
  @@schema("core")
}

model EmployeeRole {
  id         String    @id @default(uuid(7)) @db.Uuid
  employeeId String    @db.Uuid
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  roleId     String    @db.Uuid
  role       Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  reason     String?
  validFrom  DateTime  @default(now()) @db.Timestamptz(3)
  validTo    DateTime? @db.Timestamptz(3)

  @@index([employeeId, validTo])
  @@schema("core")
}

model ServiceAccountRole {
  serviceAccountId String         @db.Uuid
  serviceAccount   ServiceAccount @relation(fields: [serviceAccountId], references: [id], onDelete: Restrict)
  roleId           String         @db.Uuid
  role             Role           @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([serviceAccountId, roleId])
  @@schema("core")
}

model PermissionRule {
  id         String           @id @default(uuid(7)) @db.Uuid
  roleId     String           @db.Uuid
  role       Role             @relation(fields: [roleId], references: [id], onDelete: Cascade)
  entityType String // SalesEnquiry | SalesEstimate | Invoice | screen:sales_pipeline ...
  fieldName  String           @default("*")
  action     PermissionAction
  scope      PermissionScope  @default(OWN)
  effect     PermissionEffect @default(ALLOW)
  conditions Json? // e.g. {"toStage": "ACCOUNTS_VERIFIED"} or {"maxDiscountPct": 5}
  priority   Int              @default(100) // DENY wins at equal priority
  active     Boolean          @default(true)
  createdAt  DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime         @updatedAt @db.Timestamptz(3)

  @@index([roleId, entityType, action])
  @@schema("core")
}

// Tells the permission engine how to evaluate scopes for each entity: which
// column means "mine", "my region", "my department".
model EntityAccessConfig {
  entityType      String      @id
  ownerField      String? // e.g. "ownerId"
  regionField     String? // e.g. "regionId"
  departmentField String?
  customerField   String? // lets OWN-scoped staff see records of customers they own
  sensitivity     Sensitivity @default(NORMAL)
  logViews        Boolean     @default(true)
  updatedAt       DateTime    @updatedAt @db.Timestamptz(3)

  @@schema("core")
}

// Per-field rules: editable or derived, approval-gated, how sensitive.
model FieldPolicy {
  id                   String        @id @default(uuid(7)) @db.Uuid
  entityType           String
  fieldName            String
  editable             Boolean       @default(true)
  derived              Boolean       @default(false)
  requiresApprovalType ApprovalType?
  sensitivity          Sensitivity   @default(NORMAL)
  notes                String?
  updatedAt            DateTime      @updatedAt @db.Timestamptz(3)

  @@unique([entityType, fieldName])
  @@schema("core")
}

// ═════════════════════════════════════════════════════════════════════════════
// 4. ACCOUNTABILITY: four append-only logs (UPDATE/DELETE blocked by trigger)
// ═════════════════════════════════════════════════════════════════════════════

// Business-level events written by the service layer: stage changes,
// approvals, merges, exports — with the human reason.
model AuditEvent {
  id                String    @id @default(uuid(7)) @db.Uuid
  occurredAt        DateTime  @default(now()) @db.Timestamptz(3)
  actorType         ActorType
  actorId           String?   @db.Uuid
  sessionId         String?   @db.Uuid
  source            String // dashboard | api | automation | integration | migration
  entityType        String
  entityId          String    @db.Uuid
  operation         String // create | update | delete | transition | approve | merge | export | cancel
  changes           Json? // {"field": {"from": x, "to": y}}
  reason            String?
  approvalRequestId String?   @db.Uuid
  correlationId     String?
  requestId         String?

  @@index([entityType, entityId, occurredAt])
  @@index([actorId, occurredAt])
  @@index([occurredAt])
  @@schema("core")
}

// Written ONLY by the generic row trigger on every core and automation table:
// the full before/after image of every INSERT / UPDATE / DELETE, including
// changes made by direct SQL. The actor comes from the transaction settings
// app.actor_type / app.actor_id / app.request_id set by the service layer.
model RowChangeLog {
  id            BigInt       @id @default(autoincrement())
  occurredAt    DateTime     @default(now()) @db.Timestamptz(3)
  schemaName    String
  tableName     String
  rowId         String
  operation     RowOperation
  changedFields String[] @default([])
  oldData       Json?
  newData       Json?
  actorType     String?
  actorId       String?
  requestId     String?
  dbUser        String
  txId          BigInt

  @@index([tableName, rowId, occurredAt])
  @@index([actorId, occurredAt])
  @@schema("core")
}

// Every read: record opened, list/search results shown, export, print.
// High volume — monthly partitioning is set up in SQL.
model AccessLog {
  id               BigInt     @id @default(autoincrement())
  occurredAt       DateTime   @default(now()) @db.Timestamptz(3)
  actorType        ActorType
  actorId          String     @db.Uuid
  sessionId        String?    @db.Uuid
  accessType       AccessType
  entityType       String
  entityId         String?    @db.Uuid // single-record views
  recordIds        String[] @default([]) // ids returned by a list / search page
  resultCount      Int        @default(0)
  screen           String? // dashboard route
  filters          Json?
  sensitiveFields  String[] @default([]) // sensitive fields that were returned
  ipAddress        String?
  userAgent        String?
  requestId        String?

  @@index([entityType, entityId, occurredAt])
  @@index([actorId, occurredAt])
  @@schema("core")
}

model AuthEvent {
  id            BigInt        @id @default(autoincrement())
  occurredAt    DateTime      @default(now()) @db.Timestamptz(3)
  type          AuthEventType
  userAccountId String?       @db.Uuid
  emailTried    String?
  ipAddress     String?
  userAgent     String?
  detail        Json? // e.g. denied entity/action for PERMISSION_DENIED

  @@index([userAccountId, occurredAt])
  @@index([type, occurredAt])
  @@schema("core")
}

// ═════════════════════════════════════════════════════════════════════════════
// 5. CUSTOMER MASTER
// ═════════════════════════════════════════════════════════════════════════════

model Customer {
  id                  String              @id @default(uuid(7)) @db.Uuid
  customerNo          Int                 @unique @default(autoincrement()) // CUS-000123
  legalName           String
  displayName         String
  normalizedName      String // matching key, not unique
  gstin               String?             @unique
  pan                 String?
  gstRegistrationType GstRegistrationType @default(REGULAR)
  primaryStateCode    String? // default place of supply
  customerType        String? // mill | trader | dealer | oem | other
  status              CustomerStatus      @default(PROSPECT)
  creditLimit         Decimal?            @db.Decimal(18, 2)
  paymentTermId       String?             @db.Uuid
  paymentTerm         PaymentTerm?        @relation(fields: [paymentTermId], references: [id], onDelete: Restrict)
  priceListId         String?             @db.Uuid
  priceList           PriceList?          @relation(fields: [priceListId], references: [id], onDelete: Restrict)
  leadSourceId        String?             @db.Uuid // first acquisition source
  leadSource          LeadSource?         @relation(fields: [leadSourceId], references: [id], onDelete: Restrict)
  blockedReason       String?
  mergedIntoId        String?             @db.Uuid
  mergedInto          Customer?           @relation("CustomerMerge", fields: [mergedIntoId], references: [id], onDelete: Restrict)
  mergedFrom          Customer[]          @relation("CustomerMerge")
  createdAt           DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime            @updatedAt @db.Timestamptz(3)
  version             Int                 @default(1)

  contacts        CustomerContact[]
  addresses       CustomerAddress[]
  assignments     CustomerAssignment[]
  activities      CustomerActivity[]
  notes           CustomerNote[]
  tagAssignments  CustomerTagAssignment[]
  enquiries       SalesEnquiry[]
  estimates       SalesEstimate[]
  salesOrders     SalesOrder[]
  invoices        Invoice[]
  adjustmentNotes AdjustmentNote[]
  receipts        PaymentReceipt[]
  promises        PaymentPromise[]
  journalLines    JournalLine[]
  actions         BusinessAction[]

  @@index([normalizedName])
  @@index([status])
  @@schema("core")
}

model CustomerContact {
  id            String      @id @default(uuid(7)) @db.Uuid
  customerId    String      @db.Uuid
  customer      Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  name          String
  designation   String?
  role          ContactRole @default(OTHER)
  phoneE164     String?
  whatsappE164  String?
  email         String?
  isPrimary     Boolean     @default(false)
  whatsappOptIn Boolean     @default(false)
  optInAt       DateTime?   @db.Timestamptz(3)
  verifiedAt    DateTime?   @db.Timestamptz(3)
  active        Boolean     @default(true)
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @db.Timestamptz(3)

  activities CustomerActivity[]
  enquiries  SalesEnquiry[]
  estimates  SalesEstimate[]

  @@index([customerId])
  @@index([phoneE164])
  @@index([email])
  @@schema("core")
}

// Offices, plants/mills, billing and delivery addresses. A mill is a PLANT;
// its machine profile (roller plants, chakki count/size, brand) is millProfile.
model CustomerAddress {
  id                String      @id @default(uuid(7)) @db.Uuid
  customerId        String      @db.Uuid
  customer          Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  type              AddressType
  label             String?
  line1             String
  line2             String?
  city              String?
  district          String?
  stateCode         String // GST state code
  pincode           String?
  country           String      @default("IN")
  gstin             String? // branch GSTIN can differ by state
  latitude          Decimal?    @db.Decimal(9, 6)
  longitude         Decimal?    @db.Decimal(9, 6)
  millProfile       Json?
  isDefaultBilling  Boolean     @default(false)
  isDefaultShipping Boolean     @default(false)
  active            Boolean     @default(true)
  createdAt         DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime    @updatedAt @db.Timestamptz(3)

  estimatesBillTo SalesEstimate[] @relation("EstimateBillTo")
  estimatesShipTo SalesEstimate[] @relation("EstimateShipTo")
  ordersBillTo    SalesOrder[]    @relation("OrderBillTo")
  ordersShipTo    SalesOrder[]    @relation("OrderShipTo")

  @@index([customerId, type])
  @@index([stateCode])
  @@schema("core")
}

model CustomerAssignment {
  id           String                @id @default(uuid(7)) @db.Uuid
  customerId   String                @db.Uuid
  customer     Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  role         CustomerOwnershipRole @default(ACCOUNT_OWNER)
  employeeId   String?               @db.Uuid
  employee     Employee?             @relation("CustomerAssignee", fields: [employeeId], references: [id], onDelete: Restrict)
  teamId       String?               @db.Uuid
  team         Team?                 @relation(fields: [teamId], references: [id], onDelete: Restrict)
  regionId     String?               @db.Uuid
  region       Region?               @relation(fields: [regionId], references: [id], onDelete: Restrict)
  validFrom    DateTime              @default(now()) @db.Timestamptz(3)
  validTo      DateTime?             @db.Timestamptz(3)
  reason       String?
  assignedById String?               @db.Uuid
  assignedBy   Employee?             @relation("CustomerAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)

  @@index([customerId, role, validTo])
  @@index([employeeId, validTo])
  @@index([regionId, validTo])
  @@schema("core")
}

// The customer timeline: calls (NeoDove / device), visits, WhatsApp, emails.
// Imported rows are idempotent on (sourceSystem, sourceId).
model CustomerActivity {
  id           String             @id @default(uuid(7)) @db.Uuid
  customerId   String             @db.Uuid
  customer     Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  contactId    String?            @db.Uuid
  contact      CustomerContact?   @relation(fields: [contactId], references: [id], onDelete: Restrict)
  employeeId   String?            @db.Uuid
  employee     Employee?          @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  type         ActivityType
  direction    ActivityDirection?
  subject      String?
  body         String?
  outcome      String? // connected | not_answering | busy | callback | interested | order
  durationSec  Int?
  occurredAt   DateTime           @db.Timestamptz(3)
  sourceSystem String             @default("BUI") // BUI | NEODOVE | DEVICE | WHATSAPP | FIELD
  sourceId     String?
  recordingRef String?
  enquiryId    String?            @db.Uuid
  enquiry      SalesEnquiry?      @relation(fields: [enquiryId], references: [id], onDelete: Restrict)
  createdAt    DateTime           @default(now()) @db.Timestamptz(3)

  @@unique([sourceSystem, sourceId])
  @@index([customerId, occurredAt])
  @@index([employeeId, occurredAt])
  @@schema("core")
}

model CustomerNote {
  id         String    @id @default(uuid(7)) @db.Uuid
  customerId String    @db.Uuid
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  authorId   String    @db.Uuid
  author     Employee  @relation(fields: [authorId], references: [id], onDelete: Restrict)
  body       String
  pinned     Boolean   @default(false)
  visibility String    @default("internal") // internal | sales | accounts | management
  deletedAt  DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  @@index([customerId, createdAt])
  @@schema("core")
}

model CustomerTag {
  id        String   @id @default(uuid(7)) @db.Uuid
  key       String   @unique
  label     String
  category  String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  assignments CustomerTagAssignment[]

  @@schema("core")
}

model CustomerTagAssignment {
  customerId String      @db.Uuid
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  tagId      String      @db.Uuid
  tag        CustomerTag @relation(fields: [tagId], references: [id], onDelete: Restrict)
  createdAt  DateTime    @default(now()) @db.Timestamptz(3)

  @@id([customerId, tagId])
  @@schema("core")
}

// ═════════════════════════════════════════════════════════════════════════════
// 6. ENQUIRIES (lead intake → qualification → rates)
// ═════════════════════════════════════════════════════════════════════════════

// Controlled list of where enquiries come from (replaces free-text source).
model LeadSource {
  id        String   @id @default(uuid(7)) @db.Uuid
  code      String   @unique // TELECALLING | AI_INBOUND | INCOMING_CALL | B2B_PORTAL | FIELD_STAFF | WHATSAPP | META_ADS | GOOGLE_ADS | REFERRAL | WALK_IN
  name      String
  channel   String // outbound | inbound | marketing | partner
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  enquiries SalesEnquiry[]
  customers Customer[]

  @@schema("core")
}

// An enquiry starts UNQUALIFIED (status NEW) and may have no customer yet:
// the prospect* fields hold what the caller said. Qualifying links or creates
// the Customer. Each status change is recorded by the row trigger.
model SalesEnquiry {
  id                 String          @id @default(uuid(7)) @db.Uuid
  enquiryNo          String          @unique // from DocumentSeries (ENQUIRY)
  legalEntityId      String          @db.Uuid
  legalEntity        LegalEntity     @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  status             EnquiryStatus   @default(NEW)
  leadSourceId       String          @db.Uuid
  leadSource         LeadSource      @relation(fields: [leadSourceId], references: [id], onDelete: Restrict)
  sourceDetail       String? // campaign name, referrer, portal reference
  receivedAt         DateTime        @default(now()) @db.Timestamptz(3)
  // prospect details as captured (before / without a customer link)
  prospectCompany    String?
  prospectContact    String?
  prospectPhoneE164  String?
  prospectEmail      String?
  prospectCity       String?
  prospectStateCode  String?
  customerId         String?         @db.Uuid
  customer           Customer?       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  contactId          String?         @db.Uuid
  contact            CustomerContact? @relation(fields: [contactId], references: [id], onDelete: Restrict)
  title              String
  requirements       String?
  priority           ActionPriority  @default(MEDIUM)
  regionId           String?         @db.Uuid
  region             Region?         @relation(fields: [regionId], references: [id], onDelete: Restrict)
  ownerId            String          @db.Uuid // current responsible sales staff
  owner              Employee        @relation("EnquiryOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  generatedById      String?         @db.Uuid // whose lead it is (credit), e.g. field staff
  generatedBy        Employee?       @relation("EnquiryGenerator", fields: [generatedById], references: [id], onDelete: Restrict)
  qualifiedAt        DateTime?       @db.Timestamptz(3)
  qualifiedById      String?         @db.Uuid
  qualifiedBy        Employee?       @relation("EnquiryQualifier", fields: [qualifiedById], references: [id], onDelete: Restrict)
  disqualifyReason   String?
  lostReason         String?
  closedAt           DateTime?       @db.Timestamptz(3)
  createdAt          DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime        @updatedAt @db.Timestamptz(3)
  version            Int             @default(1)

  lines      EnquiryLine[]
  estimates  SalesEstimate[]
  activities CustomerActivity[]

  @@index([status, receivedAt])
  @@index([ownerId, status])
  @@index([regionId, status])
  @@index([customerId])
  @@index([leadSourceId, receivedAt])
  @@index([prospectPhoneE164])
  @@schema("core")
}

model EnquiryLine {
  id          String       @id @default(uuid(7)) @db.Uuid
  enquiryId   String       @db.Uuid
  enquiry     SalesEnquiry @relation(fields: [enquiryId], references: [id], onDelete: Restrict)
  lineNo      Int
  productId   String?      @db.Uuid
  product     Product?     @relation(fields: [productId], references: [id], onDelete: Restrict)
  description String
  specs       Json? // answers to ProductSpecQuestion keyed by attrKey
  quantity    Decimal      @db.Decimal(18, 3)
  uomId       String?      @db.Uuid
  uom         UnitOfMeasure? @relation(fields: [uomId], references: [id], onDelete: Restrict)
  targetPrice Decimal?     @db.Decimal(18, 4)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)

  rateQuotes    EnquiryRateQuote[]
  estimateLines SalesEstimateLine[]

  @@unique([enquiryId, lineNo])
  @@schema("core")
}

// Cost-side rates gathered for an enquiry line: from the AI rate engine,
// supplier quotes or purchase history. One is marked selected; the estimate
// line copies its cost. aiRunRef points to automation.AgentRun (soft ref).
model EnquiryRateQuote {
  id             String        @id @default(uuid(7)) @db.Uuid
  enquiryLineId  String        @db.Uuid
  enquiryLine    EnquiryLine   @relation(fields: [enquiryLineId], references: [id], onDelete: Restrict)
  supplierId     String?       @db.Uuid
  supplier       Supplier?     @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  supplierRateId String?       @db.Uuid
  supplierRate   SupplierRate? @relation(fields: [supplierRateId], references: [id], onDelete: Restrict)
  source         RateSource
  unitCost       Decimal       @db.Decimal(18, 4)
  leadTimeDays   Int?
  validUntil     DateTime?     @db.Date
  confidence     Decimal?      @db.Decimal(5, 4) // AI suggestions only
  aiRunRef       String?
  markupPct      Decimal?      @db.Decimal(7, 3)
  proposedPrice  Decimal?      @db.Decimal(18, 4)
  isSelected     Boolean       @default(false)
  notes          String?
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)

  @@index([enquiryLineId])
  @@schema("core")
}

// ═════════════════════════════════════════════════════════════════════════════
// 7. PRODUCT CATALOGUE, UNITS, TAX, PRICING, TERMS
// ═════════════════════════════════════════════════════════════════════════════

model ProductCategory {
  id        String            @id @default(uuid(7)) @db.Uuid
  code      String            @unique
  name      String
  parentId  String?           @db.Uuid
  parent    ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  ProductCategory[] @relation("CategoryTree")
  active    Boolean           @default(true)
  createdAt DateTime          @default(now()) @db.Timestamptz(3)

  products Product[]

  @@schema("core")
}

// One identity per sellable/stockable item (the SKU). Replaces ProductItem,
// StockItem and the free-text sku on order lines.
model Product {
  id             String           @id @default(uuid(7)) @db.Uuid
  sku            String           @unique // system-generated, e.g. CAT-0007
  name           String
  description    String?
  categoryId     String?          @db.Uuid
  category       ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  aliases        String[] @default([])
  brand          String?
  productType    ProductType      @default(GOODS)
  hsnCode        String? // HSN (goods) / SAC (services) — required on invoices
  baseUomId      String           @db.Uuid
  baseUom        UnitOfMeasure    @relation(fields: [baseUomId], references: [id], onDelete: Restrict)
  taxRateId      String?          @db.Uuid
  taxRate        TaxRate?         @relation(fields: [taxRateId], references: [id], onDelete: Restrict)
  isStocked      Boolean          @default(true)
  barcode        String?
  imageStorageKey String?
  specs          Json? // fixed attributes of this SKU
  reorderLevel   Decimal          @default(0) @db.Decimal(18, 3)
  minLevel       Decimal          @default(0) @db.Decimal(18, 3)
  maxLevel       Decimal          @default(0) @db.Decimal(18, 3)
  leadTimeDays   Int?
  active         Boolean          @default(true)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)

  specQuestions    ProductSpecQuestion[]
  unitConversions  ProductUnitConversion[]
  priceListItems   PriceListItem[]
  supplierRates    SupplierRate[]
  enquiryLines     EnquiryLine[]
  estimateLines    SalesEstimateLine[]
  orderLines       SalesOrderLine[]
  stockEntries     StockLedgerEntry[]
  reservations     InventoryReservation[]
  dispatchLines    DispatchLine[]
  invoiceLines     InvoiceLine[]
  noteLines        AdjustmentNoteLine[]
  poLines          PurchaseOrderLine[]
  grnLines         GoodsReceiptLine[]
  billLines        SupplierBillLine[]

  @@index([categoryId, active])
  @@index([hsnCode])
  @@schema("core")
}

// "Know Your Product" checklist: the spec questions sales must answer for
// this product (replaces KypGuide). attrKey is a stable slug — never rename.
model ProductSpecQuestion {
  id         String   @id @default(uuid(7)) @db.Uuid
  productId  String   @db.Uuid
  product    Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  attrKey    String
  question   String
  guideNote  String?
  sortOrder  Int      @default(0)
  isRequired Boolean  @default(true)
  condition  Json?
  active     Boolean  @default(true)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@unique([productId, attrKey])
  @@schema("core")
}

model UnitOfMeasure {
  id        String  @id @default(uuid(7)) @db.Uuid
  code      String  @unique // NOS | KGS | MTR | SET | BOX
  name      String
  gstUqc    String // GST Unique Quantity Code used in e-invoice / GSTR-1
  decimals  Int     @default(0)
  active    Boolean @default(true)

  products        Product[]
  conversionsFrom ProductUnitConversion[] @relation("ConvFrom")
  conversionsTo   ProductUnitConversion[] @relation("ConvTo")
  enquiryLines    EnquiryLine[]
  estimateLines   SalesEstimateLine[]
  orderLines      SalesOrderLine[]
  invoiceLines    InvoiceLine[]
  poLines         PurchaseOrderLine[]
  supplierRates   SupplierRate[]

  @@schema("core")
}

model ProductUnitConversion {
  id        String        @id @default(uuid(7)) @db.Uuid
  productId String        @db.Uuid
  product   Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  fromUomId String        @db.Uuid
  fromUom   UnitOfMeasure @relation("ConvFrom", fields: [fromUomId], references: [id], onDelete: Restrict)
  toUomId   String        @db.Uuid
  toUom     UnitOfMeasure @relation("ConvTo", fields: [toUomId], references: [id], onDelete: Restrict)
  factor    Decimal       @db.Decimal(18, 6) // 1 fromUom = factor × toUom

  @@unique([productId, fromUomId, toUomId])
  @@schema("core")
}

// GST rate table — never hard-code slabs; rates change by notification.
model TaxRate {
  id            String    @id @default(uuid(7)) @db.Uuid
  code          String    @unique // GST0 | GST5 | GST18 | GST40 | EXEMPT | NIL
  name          String
  gstRate       Decimal   @db.Decimal(5, 2) // total GST %, split CGST/SGST or IGST at document time
  cessRate      Decimal   @default(0) @db.Decimal(5, 2)
  isExempt      Boolean   @default(false)
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date
  active        Boolean   @default(true)

  products Product[]

  @@schema("core")
}

model PriceList {
  id        String    @id @default(uuid(7)) @db.Uuid
  code      String    @unique
  name      String
  currency  String    @default("INR")
  isDefault Boolean   @default(false)
  validFrom DateTime? @db.Date
  validTo   DateTime? @db.Date
  active    Boolean   @default(true)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  items     PriceListItem[]
  customers Customer[]

  @@schema("core")
}

model PriceListItem {
  id          String    @id @default(uuid(7)) @db.Uuid
  priceListId String    @db.Uuid
  priceList   PriceList @relation(fields: [priceListId], references: [id], onDelete: Restrict)
  productId   String    @db.Uuid
  product     Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  unitPrice   Decimal   @db.Decimal(18, 4)
  minQty      Decimal   @default(0) @db.Decimal(18, 3)
  validFrom   DateTime  @db.Date
  validTo     DateTime? @db.Date
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  @@index([priceListId, productId, validFrom])
  @@schema("core")
}

model PaymentTerm {
  id         String   @id @default(uuid(7)) @db.Uuid
  code       String   @unique // ADVANCE_100 | NET15 | NET30 | 50_ADV_50_DISPATCH
  name       String
  dueDays    Int      @default(0)
  advancePct Decimal  @default(0) @db.Decimal(5, 2)
  active     Boolean  @default(true)

  customers   Customer[]
  salesOrders SalesOrder[]
  suppliers   Supplier[]

  @@schema("core")
}

// ═════════════════════════════════════════════════════════════════════════════
// 8. SUPPLIERS & PURCHASING
// ═════════════════════════════════════════════════════════════════════════════

model Supplier {
  id              String       @id @default(uuid(7)) @db.Uuid
  code            String       @unique
  name            String
  legalName       String?
  gstin           String?      @unique
  pan             String?
  supplierType    String? // manufacturer | distributor | trader
  yearEstablished Int?
  phoneE164       String?
  email           String?
  addressLine     String?
  city            String?
  stateCode       String?
  pincode         String?
  paymentTermId   String?      @db.Uuid
  paymentTerm     PaymentTerm? @relation(fields: [paymentTermId], references: [id], onDelete: Restrict)
  active          Boolean      @default(true) // deactivate, never delete
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(3)

  contacts       SupplierContact[]
  rates          SupplierRate[]
  rateQuotes     EnquiryRateQuote[]
  purchaseOrders PurchaseOrder[]
  goodsReceipts  GoodsReceipt[]
  bills          SupplierBill[]
  payments       SupplierPayment[]
  journalLines   JournalLine[]

  @@schema("core")
}

model SupplierContact {
  id         String   @id @default(uuid(7)) @db.Uuid
  supplierId String   @db.Uuid
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  name       String
  phoneE164  String?
  email      String?
  isPrimary  Boolean  @default(false)
  active     Boolean  @default(true)

  @@index([supplierId])
  @@schema("core")
}

// Supplier price facts, keyed by the spec signature (same item with different
// dimensions/brand is a different rate). Replaces VendorRate.
model SupplierRate {
  id              String         @id @default(uuid(7)) @db.Uuid
  supplierId      String         @db.Uuid
  supplier        Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  productId       String?        @db.Uuid
  product         Product?       @relation(fields: [productId], references: [id], onDelete: Restrict)
  specSignature   String         @default("") // canonical string of spec values
  specValues      Json?
  unitCost        Decimal        @db.Decimal(18, 4)
  uomId           String?        @db.Uuid
  uom             UnitOfMeasure? @relation(fields: [uomId], references: [id], onDelete: Restrict)
  discountPct     Decimal?       @db.Decimal(7, 3)
  baseRate        Decimal?       @db.Decimal(18, 4)
  weightPerUnit   Decimal?       @db.Decimal(18, 3)
  packageQty      String?
  packageDims     String?
  moq             String?
  leadTimeDays    Int?
  source          RateSource     @default(SUPPLIER_QUOTE)
  quotedAt        DateTime       @default(now()) @db.Timestamptz(3)
  validUntil      DateTime?      @db.Date
  notes           String?
  missingSpecs    String[] @default([])
  active          Boolean        @default(true)
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)

  rateQuotes EnquiryRateQuote[]

  @@index([productId, specSignature])
  @@index([supplierId])
  @@schema("core")
}

model PurchaseOrder {
  id               String              @id @default(uuid(7)) @db.Uuid
  poNo             String              @unique
  legalEntityId    String              @db.Uuid
  legalEntity      LegalEntity         @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  supplierId       String              @db.Uuid
  supplier         Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  salesOrderId     String?             @db.Uuid // back-to-back procurement
  salesOrder       SalesOrder?         @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  warehouseId      String              @db.Uuid
  warehouse        Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  status           PurchaseOrderStatus @default(DRAFT)
  orderDate        DateTime            @db.Date
  expectedDate     DateTime?           @db.Date
  placeOfSupply    String
  subtotal         Decimal             @default(0) @db.Decimal(18, 2)
  taxTotal         Decimal             @default(0) @db.Decimal(18, 2)
  grandTotal       Decimal             @default(0) @db.Decimal(18, 2)
  notes            String?
  createdAt        DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @db.Timestamptz(3)
  version          Int                 @default(1)

  lines         PurchaseOrderLine[]
  goodsReceipts GoodsReceipt[]

  @@index([supplierId, status])
  @@index([salesOrderId])
  @@schema("core")
}

model PurchaseOrderLine {
  id               String          @id @default(uuid(7)) @db.Uuid
  purchaseOrderId  String          @db.Uuid
  purchaseOrder    PurchaseOrder   @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  lineNo           Int
  productId        String          @db.Uuid
  product          Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  salesOrderLineId String?         @db.Uuid
  salesOrderLine   SalesOrderLine? @relation(fields: [salesOrderLineId], references: [id], onDelete: Restrict)
  description      String?
  quantity         Decimal         @db.Decimal(18, 3)
  uomId            String          @db.Uuid
  uom              UnitOfMeasure   @relation(fields: [uomId], references: [id], onDelete: Restrict)
  unitCost         Decimal         @db.Decimal(18, 4)
  gstRate          Decimal         @db.Decimal(5, 2)
  taxableValue     Decimal         @db.Decimal(18, 2)
  taxAmount        Decimal         @db.Decimal(18, 2)
  lineTotal        Decimal         @db.Decimal(18, 2)

  grnLines GoodsReceiptLine[]

  @@unique([purchaseOrderId, lineNo])
  @@schema("core")
}

// Posting a GRN writes PURCHASE_RECEIPT entries to the stock ledger.
model GoodsReceipt {
  id                 String         @id @default(uuid(7)) @db.Uuid
  grnNo              String         @unique
  legalEntityId      String         @db.Uuid
  legalEntity        LegalEntity    @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  purchaseOrderId    String?        @db.Uuid
  purchaseOrder      PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  supplierId         String         @db.Uuid
  supplier           Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  warehouseId        String         @db.Uuid
  warehouse          Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  receivedDate       DateTime       @db.Date
  supplierInvoiceRef String?
  status             PostingStatus  @default(DRAFT)
  postedAt           DateTime?      @db.Timestamptz(3)
  createdAt          DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime       @updatedAt @db.Timestamptz(3)

  lines GoodsReceiptLine[]
  bills SupplierBill[]

  @@schema("core")
}

model GoodsReceiptLine {
  id                  String             @id @default(uuid(7)) @db.Uuid
  goodsReceiptId      String             @db.Uuid
  goodsReceipt        GoodsReceipt       @relation(fields: [goodsReceiptId], references: [id], onDelete: Restrict)
  purchaseOrderLineId String?            @db.Uuid
  purchaseOrderLine   PurchaseOrderLine? @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Restrict)
  productId           String             @db.Uuid
  product             Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  qtyReceived         Decimal            @db.Decimal(18, 3)
  qtyAccepted         Decimal            @db.Decimal(18, 3)
  qtyRejected         Decimal            @default(0) @db.Decimal(18, 3)
  unitCost            Decimal            @db.Decimal(18, 4)

  @@index([goodsReceiptId])
  @@schema("core")
}

// Supplier's tax invoice (input tax credit). Posting creates the journal.
model SupplierBill {
  id               String        @id @default(uuid(7)) @db.Uuid
  internalNo       String        @unique // our reference (DocumentSeries SUPPLIER_BILL)
  supplierBillNo   String // the supplier's invoice number
  legalEntityId    String        @db.Uuid
  legalEntity      LegalEntity   @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  supplierId       String        @db.Uuid
  supplier         Supplier      @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  goodsReceiptId   String?       @db.Uuid
  goodsReceipt     GoodsReceipt? @relation(fields: [goodsReceiptId], references: [id], onDelete: Restrict)
  billDate         DateTime      @db.Date
  dueDate          DateTime?     @db.Date
  placeOfSupply    String
  reverseCharge    Boolean       @default(false)
  itcEligible      Boolean       @default(true)
  taxableTotal     Decimal       @db.Decimal(18, 2)
  cgstTotal        Decimal       @default(0) @db.Decimal(18, 2)
  sgstTotal        Decimal       @default(0) @db.Decimal(18, 2)
  igstTotal        Decimal       @default(0) @db.Decimal(18, 2)
  cessTotal        Decimal       @default(0) @db.Decimal(18, 2)
  roundOff         Decimal       @default(0) @db.Decimal(18, 2)
  grandTotal       Decimal       @db.Decimal(18, 2)
  status           PostingStatus @default(DRAFT)
  postedAt         DateTime?     @db.Timestamptz(3)
  createdAt        DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @db.Timestamptz(3)

  lines       SupplierBillLine[]
  allocations SupplierPaymentAllocation[]

  @@unique([supplierId, supplierBillNo, billDate])
  @@schema("core")
}

model SupplierBillLine {
  id             String       @id @default(uuid(7)) @db.Uuid
  supplierBillId String       @db.Uuid
  supplierBill   SupplierBill @relation(fields: [supplierBillId], references: [id], onDelete: Restrict)
  lineNo         Int
  productId      String?      @db.Uuid
  product        Product?     @relation(fields: [productId], references: [id], onDelete: Restrict)
  description    String
  hsnCode        String?
  quantity       Decimal      @db.Decimal(18, 3)
  unitCost       Decimal      @db.Decimal(18, 4)
  taxableValue   Decimal      @db.Decimal(18, 2)
  gstRate        Decimal      @db.Decimal(5, 2)
  cgstAmount     Decimal      @default(0) @db.Decimal(18, 2)
  sgstAmount     Decimal      @default(0) @db.Decimal(18, 2)
  igstAmount     Decimal      @default(0) @db.Decimal(18, 2)
  cessAmount     Decimal      @default(0) @db.Decimal(18, 2)
  lineTotal      Decimal      @db.Decimal(18, 2)

  @@unique([supplierBillId, lineNo])
  @@schema("core")
}

model SupplierPayment {
  id            String        @id @default(uuid(7)) @db.Uuid
  paymentNo     String        @unique
  legalEntityId String        @db.Uuid
  legalEntity   LegalEntity   @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  supplierId    String        @db.Uuid
  supplier      Supplier      @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  bankAccountId String?       @db.Uuid
  bankAccount   BankAccount?  @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  paidOn        DateTime      @db.Date
  mode          PaymentMode
  amount        Decimal       @db.Decimal(18, 2)
  tdsDeducted   Decimal       @default(0) @db.Decimal(18, 2)
  referenceNo   String?
  status        PostingStatus @default(DRAFT)
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)

  allocations SupplierPaymentAllocation[]

  @@schema("core")
}

model SupplierPaymentAllocation {
  id                String          @id @default(uuid(7)) @db.Uuid
  supplierPaymentId String          @db.Uuid
  supplierPayment   SupplierPayment @relation(fields: [supplierPaymentId], references: [id], onDelete: Restrict)
  supplierBillId    String          @db.Uuid
  supplierBill      SupplierBill    @relation(fields: [supplierBillId], references: [id], onDelete: Restrict)
  amount            Decimal         @db.Decimal(18, 2)
  reversedAt        DateTime?       @db.Timestamptz(3)
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)

  @@index([supplierBillId])
  @@schema("core")
}

// ═════════════════════════════════════════════════════════════════════════════
// 9. ESTIMATES (replaces Zoho estimates)
// ═════════════════════════════════════════════════════════════════════════════

// Revisions: a changed estimate after sending becomes a new row with
// revision+1 and previousRevisionId; the old one becomes SUPERSEDED.
model SalesEstimate {
  id                 String           @id @default(uuid(7)) @db.Uuid
  estimateNo         String // same number across revisions (EST-024014)
  revision           Int              @default(1)
  previousRevisionId String?          @unique @db.Uuid
  previousRevision   SalesEstimate?   @relation("EstimateRevision", fields: [previousRevisionId], references: [id], onDelete: Restrict)
  nextRevision       SalesEstimate?   @relation("EstimateRevision")
  legalEntityId      String           @db.Uuid
  legalEntity        LegalEntity      @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  enquiryId          String?          @db.Uuid
  enquiry            SalesEnquiry?    @relation(fields: [enquiryId], references: [id], onDelete: Restrict)
  customerId         String           @db.Uuid
  customer           Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  contactId          String?          @db.Uuid
  contact            CustomerContact? @relation(fields: [contactId], references: [id], onDelete: Restrict)
  billToAddressId    String?          @db.Uuid
  billToAddress      CustomerAddress? @relation("EstimateBillTo", fields: [billToAddressId], references: [id], onDelete: Restrict)
  shipToAddressId    String?          @db.Uuid
  shipToAddress      CustomerAddress? @relation("EstimateShipTo", fields: [shipToAddressId], references: [id], onDelete: Restrict)
  status             EstimateStatus   @default(DRAFT)
  estimateDate       DateTime         @db.Date
  validUntil         DateTime?        @db.Date
  placeOfSupply      String // GST state code — decides CGST+SGST vs IGST
  currency           String           @default("INR")
  subtotal           Decimal          @default(0) @db.Decimal(18, 2)
  discountTotal      Decimal          @default(0) @db.Decimal(18, 2)
  taxableTotal       Decimal          @default(0) @db.Decimal(18, 2)
  cgstTotal          Decimal          @default(0) @db.Decimal(18, 2)
  sgstTotal          Decimal          @default(0) @db.Decimal(18, 2)
  igstTotal          Decimal          @default(0) @db.Decimal(18, 2)
  cessTotal          Decimal          @default(0) @db.Decimal(18, 2)
  roundOff           Decimal          @default(0) @db.Decimal(18, 2)
  grandTotal         Decimal          @default(0) @db.Decimal(18, 2)
  terms              String?
  customerNotes      String?
  internalNotes      String?
  regionId           String?          @db.Uuid
  region             Region?          @relation(fields: [regionId], references: [id], onDelete: Restrict)
  ownerId            String           @db.Uuid // current holder
  owner              Employee         @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  nextStep           String? // dated customer commitment ("confirms on 15th")
  nextStepDate       DateTime?        @db.Date
  sentAt             DateTime?        @db.Timestamptz(3)
  acceptedAt         DateTime?        @db.Timestamptz(3)
  declinedAt         DateTime?        @db.Timestamptz(3)
  declineReason      String?
  createdAt          DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @db.Timestamptz(3)
  version            Int              @default(1)

  lines        SalesEstimateLine[]
  assignments  SalesEstimateAssignment[]
  salesOrders  SalesOrder[]

  @@unique([legalEntityId, estimateNo, revision])
  @@index([status, estimateDate])
  @@index([ownerId, status])
  @@index([regionId, status])
  @@index([customerId])
  @@index([enquiryId])
  @@schema("core")
}

model SalesEstimateLine {
  id            String         @id @default(uuid(7)) @db.Uuid
  estimateId    String         @db.Uuid
  estimate      SalesEstimate  @relation(fields: [estimateId], references: [id], onDelete: Restrict)
  lineNo        Int
  enquiryLineId String?        @db.Uuid
  enquiryLine   EnquiryLine?   @relation(fields: [enquiryLineId], references: [id], onDelete: Restrict)
  productId     String?        @db.Uuid
  product       Product?       @relation(fields: [productId], references: [id], onDelete: Restrict)
  description   String
  hsnCode       String?
  quantity      Decimal        @db.Decimal(18, 3)
  uomId         String         @db.Uuid
  uom           UnitOfMeasure  @relation(fields: [uomId], references: [id], onDelete: Restrict)
  unitPrice     Decimal        @db.Decimal(18, 4)
  discountPct   Decimal        @default(0) @db.Decimal(7, 3)
  discountAmt   Decimal        @default(0) @db.Decimal(18, 2)
  taxableValue  Decimal        @db.Decimal(18, 2)
  gstRate       Decimal        @db.Decimal(5, 2)
  cgstAmount    Decimal        @default(0) @db.Decimal(18, 2)
  sgstAmount    Decimal        @default(0) @db.Decimal(18, 2)
  igstAmount    Decimal        @default(0) @db.Decimal(18, 2)
  cessAmount    Decimal        @default(0) @db.Decimal(18, 2)
  lineTotal     Decimal        @db.Decimal(18, 2)
  unitCost      Decimal?       @db.Decimal(18, 4) // SENSITIVE: from the selected rate quote
  specs         Json?

  orderLines SalesOrderLine[]

  @@unique([estimateId, lineNo])
  @@schema("core")
}

// Who held the estimate when (end-of-day reassignment, absentee covers).
model SalesEstimateAssignment {
  id                 String        @id @default(uuid(7)) @db.Uuid
  estimateId         String        @db.Uuid
  estimate           SalesEstimate @relation(fields: [estimateId], references: [id], onDelete: Restrict)
  employeeId         String        @db.Uuid
  employee           Employee      @relation("EstimateHolder", fields: [employeeId], references: [id], onDelete: Restrict)
  coverForEmployeeId String?       @db.Uuid // temp cover: returns to this person
  coverFor           Employee?     @relation("EstimateCoverFor", fields: [coverForEmployeeId], references: [id], onDelete: Restrict)
  validFrom          DateTime      @default(now()) @db.Timestamptz(3)
  validTo            DateTime?     @db.Timestamptz(3)
  reason             String? // why the previous holder lost it

  @@index([estimateId, validTo])
  @@index([employeeId, validTo])
  @@schema("core")
}

// ═════════════════════════════════════════════════════════════════════════════
// 10. SALES ORDERS + STAGE MACHINE
// ═════════════════════════════════════════════════════════════════════════════

model SalesOrder {
  id               String           @id @default(uuid(7)) @db.Uuid
  soNo             String           @unique
  legalEntityId    String           @db.Uuid
  legalEntity      LegalEntity      @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  estimateId       String?          @db.Uuid
  estimate         SalesEstimate?   @relation(fields: [estimateId], references: [id], onDelete: Restrict)
  customerId       String           @db.Uuid
  customer         Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  billToAddressId  String?          @db.Uuid
  billToAddress    CustomerAddress? @relation("OrderBillTo", fields: [billToAddressId], references: [id], onDelete: Restrict)
  shipToAddressId  String?          @db.Uuid
  shipToAddress    CustomerAddress? @relation("OrderShipTo", fields: [shipToAddressId], references: [id], onDelete: Restrict)
  customerPoNo     String?
  customerPoDate   DateTime?        @db.Date
  orderDate        DateTime         @db.Date
  stage            SalesOrderStage  @default(DRAFT)
  stageChangedAt   DateTime         @default(now()) @db.Timestamptz(3)
  holdReason       String?
  cancelReason     String?
  placeOfSupply    String
  paymentTermId    String?          @db.Uuid
  paymentTerm      PaymentTerm?     @relation(fields: [paymentTermId], references: [id], onDelete: Restrict)
  expectedDispatch DateTime?        @db.Date
  subtotal         Decimal          @default(0) @db.Decimal(18, 2)
  discountTotal    Decimal          @default(0) @db.Decimal(18, 2)
  taxableTotal     Decimal          @default(0) @db.Decimal(18, 2)
  cgstTotal        Decimal          @default(0) @db.Decimal(18, 2)
  sgstTotal        Decimal          @default(0) @db.Decimal(18, 2)
  igstTotal        Decimal          @default(0) @db.Decimal(18, 2)
  cessTotal        Decimal          @default(0) @db.Decimal(18, 2)
  roundOff         Decimal          @default(0) @db.Decimal(18, 2)
  grandTotal       Decimal          @default(0) @db.Decimal(18, 2)
  regionId         String?          @db.Uuid
  region           Region?          @relation(fields: [regionId], references: [id], onDelete: Restrict)
  ownerId          String           @db.Uuid
  owner            Employee         @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(3)
  version          Int              @default(1)

  lines          SalesOrderLine[]
  stageEvents    SalesOrderStageEvent[]
  dispatches     Dispatch[]
  invoices       Invoice[]
  purchaseOrders PurchaseOrder[]
  advances       PaymentAllocation[]

  @@index([stage, stageChangedAt])
  @@index([ownerId, stage])
  @@index([regionId, stage])
  @@index([customerId])
  @@index([estimateId])
  @@schema("core")
}

model SalesOrderLine {
  id                String             @id @default(uuid(7)) @db.Uuid
  salesOrderId      String             @db.Uuid
  salesOrder        SalesOrder         @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  lineNo            Int
  estimateLineId    String?            @db.Uuid
  estimateLine      SalesEstimateLine? @relation(fields: [estimateLineId], references: [id], onDelete: Restrict)
  productId         String             @db.Uuid
  product           Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  description       String
  hsnCode           String?
  quantity          Decimal            @db.Decimal(18, 3)
  uomId             String             @db.Uuid
  uom               UnitOfMeasure      @relation(fields: [uomId], references: [id], onDelete: Restrict)
  unitPrice         Decimal            @db.Decimal(18, 4)
  discountPct       Decimal            @default(0) @db.Decimal(7, 3)
  discountAmt       Decimal            @default(0) @db.Decimal(18, 2)
  taxableValue      Decimal            @db.Decimal(18, 2)
  gstRate           Decimal            @db.Decimal(5, 2)
  cgstAmount        Decimal            @default(0) @db.Decimal(18, 2)
  sgstAmount        Decimal            @default(0) @db.Decimal(18, 2)
  igstAmount        Decimal            @default(0) @db.Decimal(18, 2)
  cessAmount        Decimal            @default(0) @db.Decimal(18, 2)
  lineTotal         Decimal            @db.Decimal(18, 2)
  unitCost          Decimal?           @db.Decimal(18, 4) // SENSITIVE
  plannedDispatch   DateTime?          @db.Date
  cancelledQty      Decimal            @default(0) @db.Decimal(18, 3)
  cancelReason      String?
  // Reserved / dispatched / invoiced quantities are DERIVED from
  // InventoryReservation, DispatchLine and InvoiceLine (views in SQL).

  reservations   InventoryReservation[]
  dispatchLines  DispatchLine[]
  invoiceLines   InvoiceLine[]
  poLines        PurchaseOrderLine[]

  @@unique([salesOrderId, lineNo])
  @@index([productId])
  @@schema("core")
}

// Append-only stage history. The service layer only moves an order when
// every StageGateRule for the target stage passes.
model SalesOrderStageEvent {
  id                String            @id @default(uuid(7)) @db.Uuid
  salesOrderId      String            @db.Uuid
  salesOrder        SalesOrder        @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  fromStage         SalesOrderStage?
  toStage           SalesOrderStage
  actorType         ActorType
  actorEmployeeId   String?           @db.Uuid
  actorEmployee     Employee?         @relation(fields: [actorEmployeeId], references: [id], onDelete: Restrict)
  reason            String?
  approvalRequestId String?           @db.Uuid
  approvalRequest   ApprovalRequest?  @relation(fields: [approvalRequestId], references: [id], onDelete: Restrict)
  occurredAt        DateTime          @default(now()) @db.Timestamptz(3)

  @@index([salesOrderId, occurredAt])
  @@index([toStage, occurredAt])
  @@schema("core")
}

// Conditions for entering a stage. checkKey names a check implemented in the
// core service (e.g. all_lines_reserved, advance_received_or_credit_ok,
// eway_bill_ready). requiredApprovalType = an APPROVED ApprovalRequest of
// that type must exist for the order. allowedRoleId = who may trigger it.
model StageGateRule {
  id                   String        @id @default(uuid(7)) @db.Uuid
  entityType           String        @default("SalesOrder")
  toStage              String
  fromStages           String[] @default([]) // empty = any
  checkKey             String?
  checkParams          Json?
  requiredApprovalType ApprovalType?
  allowedRoleId        String?       @db.Uuid
  allowedRole          Role?         @relation(fields: [allowedRoleId], references: [id], onDelete: Restrict)
  description          String
  active               Boolean       @default(true)
  updatedAt            DateTime      @updatedAt @db.Timestamptz(3)

  @@index([entityType, toStage])
  @@schema("core")
}

// Sales credit for leaderboards/incentives: generator (lead) and closer.
model SalesCredit {
  id           String          @id @default(uuid(7)) @db.Uuid
  employeeId   String          @db.Uuid
  employee     Employee        @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  role         SalesCreditRole
  documentType String // SalesEstimate | SalesOrder
  documentId   String          @db.Uuid
  sharePct     Decimal         @db.Decimal(5, 2) // e.g. 20 / 80
  amount       Decimal         @db.Decimal(18, 2)
  creditedOn   DateTime        @db.Date
  reversedAt   DateTime?       @db.Timestamptz(3)
  reason       String?
  createdAt    DateTime        @default(now()) @db.Timestamptz(3)

  @@unique([documentType, documentId, role, employeeId])
  @@index([employeeId, creditedOn])
  @@schema("core")
}

// ═════════════════════════════════════════════════════════════════════════════
// 11. INVENTORY
// ═════════════════════════════════════════════════════════════════════════════

model Warehouse {
  id            String      @id @default(uuid(7)) @db.Uuid
  code          String      @unique
  name          String
  legalEntityId String      @db.Uuid
  legalEntity   LegalEntity @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  address       String?
  stateCode     String
  active        Boolean     @default(true)
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)

  stockEntries   StockLedgerEntry[]
  reservations   InventoryReservation[]
  dispatches     Dispatch[]
  purchaseOrders PurchaseOrder[]
  goodsReceipts  GoodsReceipt[]

  @@schema("core")
}

// Immutable stock ledger. On-hand = SUM(quantity) per product+warehouse;
// available = on-hand − ACTIVE reservations. Corrections are new entries
// (reversalOfId), never edits.
model StockLedgerEntry {
  id            String            @id @default(uuid(7)) @db.Uuid
  productId     String            @db.Uuid
  product       Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouseId   String            @db.Uuid
  warehouse     Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  movementType  StockMovementType
  quantity      Decimal           @db.Decimal(18, 3) // signed: + in, − out
  unitCost      Decimal           @default(0) @db.Decimal(18, 4)
  postingDate   DateTime          @db.Date
  sourceDocType String // GoodsReceipt | Dispatch | AdjustmentNote | StockAdjustment | Opening
  sourceDocId   String            @db.Uuid
  sourceLineId  String?           @db.Uuid
  reversalOfId  String?           @unique @db.Uuid
  reversalOf    StockLedgerEntry? @relation("StockReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy    StockLedgerEntry? @relation("StockReversal")
  note          String?
  createdAt     DateTime          @default(now()) @db.Timestamptz(3)

  @@unique([sourceDocType, sourceLineId, movementType]) // a source line posts once
  @@index([productId, warehouseId, postingDate])
  @@index([sourceDocType, sourceDocId])
  @@schema("core")
}

model InventoryReservation {
  id               String            @id @default(uuid(7)) @db.Uuid
  salesOrderLineId String            @db.Uuid
  salesOrderLine   SalesOrderLine    @relation(fields: [salesOrderLineId], references: [id], onDelete: Restrict)
  productId        String            @db.Uuid
  product          Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouseId      String            @db.Uuid
  warehouse        Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  quantity         Decimal           @db.Decimal(18, 3)
  status           ReservationStatus @default(ACTIVE)
  reservedAt       DateTime          @default(now()) @db.Timestamptz(3)
  releasedAt       DateTime?         @db.Timestamptz(3)
  releaseReason    String?
  consumedByLineId String?           @db.Uuid // DispatchLine that consumed it
  consumedByLine   DispatchLine?     @relation(fields: [consumedByLineId], references: [id], onDelete: Restrict)

  @@index([productId, warehouseId, status])
  @@index([salesOrderLineId, status])
  @@schema("core")
}

// ═════════════════════════════════════════════════════════════════════════════
// 12. DISPATCH
// ═════════════════════════════════════════════════════════════════════════════

model Dispatch {
  id                 String         @id @default(uuid(7)) @db.Uuid
  dispatchNo         String         @unique
  legalEntityId      String         @db.Uuid
  legalEntity        LegalEntity    @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  salesOrderId       String         @db.Uuid
  salesOrder         SalesOrder     @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  warehouseId        String         @db.Uuid
  warehouse          Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  status             DispatchStatus @default(PLANNED)
  plannedDate        DateTime       @db.Date
  shipToSnapshot     Json // address as printed on the documents
  transporterName    String?
  transporterGstinId String? // GST transporter id
  vehicleNo          String?
  lrNumber           String?
  lrDate             DateTime?      @db.Date
  distanceKm         Int?
  eWayBillStatus     EWayBillStatus @default(NOT_REQUIRED)
  eWayBillNo         String?        @unique
  eWayBillDate       DateTime?      @db.Timestamptz(3)
  eWayBillValidUntil DateTime?      @db.Timestamptz(3)
  eWayBillError      String?
  dispatchedAt       DateTime?      @db.Timestamptz(3)
  deliveredAt        DateTime?      @db.Timestamptz(3)
  delayReason        String?
  cancelReason       String?
  createdAt          DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime       @updatedAt @db.Timestamptz(3)
  version            Int            @default(1)

  lines   DispatchLine[]
  events  DispatchEvent[]
  invoice Invoice?

  @@index([status, plannedDate])
  @@index([salesOrderId])
  @@schema("core")
}

model DispatchLine {
  id               String         @id @default(uuid(7)) @db.Uuid
  dispatchId       String         @db.Uuid
  dispatch         Dispatch       @relation(fields: [dispatchId], references: [id], onDelete: Restrict)
  salesOrderLineId String         @db.Uuid
  salesOrderLine   SalesOrderLine @relation(fields: [salesOrderLineId], references: [id], onDelete: Restrict)
  productId        String         @db.Uuid
  product          Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity         Decimal        @db.Decimal(18, 3)

  reservationsConsumed InventoryReservation[]
  invoiceLines         InvoiceLine[]

  @@index([dispatchId])
  @@index([salesOrderLineId])
  @@schema("core")
}

model DispatchEvent {
  id         String            @id @default(uuid(7)) @db.Uuid
  dispatchId String            @db.Uuid
  dispatch   Dispatch          @relation(fields: [dispatchId], references: [id], onDelete: Restrict)
  kind       DispatchEventKind
  fromDate   DateTime?         @db.Date
  toDate     DateTime?         @db.Date
  reason     String?
  occurredAt DateTime          @default(now()) @db.Timestamptz(3)

  @@index([dispatchId, occurredAt])
  @@schema("core")
}

// ═════════════════════════════════════════════════════════════════════════════
// 13. INVOICING, GST, RECEIVABLES (replaces Zoho Books)
// ═════════════════════════════════════════════════════════════════════════════

// A legal tax document. Once ISSUED it is frozen (trigger): only the
// e-invoice fields and cancellation may change. Party details are snapshots
// so a reprint years later shows exactly what was issued.
model Invoice {
  id               String         @id @default(uuid(7)) @db.Uuid
  invoiceNo        String // ≤ 16 chars, unique per legal entity per FY
  documentType     DocumentType   @default(TAX_INVOICE) // TAX_INVOICE | BILL_OF_SUPPLY
  legalEntityId    String         @db.Uuid
  legalEntity      LegalEntity    @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  customerId       String         @db.Uuid
  customer         Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  salesOrderId     String?        @db.Uuid
  salesOrder       SalesOrder?    @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  dispatchId       String?        @unique @db.Uuid
  dispatch         Dispatch?      @relation(fields: [dispatchId], references: [id], onDelete: Restrict)
  invoiceDate      DateTime       @db.Date
  dueDate          DateTime?      @db.Date
  supplyType       SupplyType     @default(B2B)
  placeOfSupply    String
  reverseCharge    Boolean        @default(false)
  sellerSnapshot   Json
  buyerSnapshot    Json
  shipToSnapshot   Json?
  subtotal         Decimal        @db.Decimal(18, 2)
  discountTotal    Decimal        @default(0) @db.Decimal(18, 2)
  taxableTotal     Decimal        @db.Decimal(18, 2)
  cgstTotal        Decimal        @default(0) @db.Decimal(18, 2)
  sgstTotal        Decimal        @default(0) @db.Decimal(18, 2)
  igstTotal        Decimal        @default(0) @db.Decimal(18, 2)
  cessTotal        Decimal        @default(0) @db.Decimal(18, 2)
  tcsAmount        Decimal        @default(0) @db.Decimal(18, 2)
  roundOff         Decimal        @default(0) @db.Decimal(18, 2)
  grandTotal       Decimal        @db.Decimal(18, 2)
  amountInWords    String?
  terms            String?
  status           InvoiceStatus  @default(DRAFT)
  issuedAt         DateTime?      @db.Timestamptz(3)
  cancelledAt      DateTime?      @db.Timestamptz(3)
  cancelReason     String?
  eInvoiceStatus   EInvoiceStatus @default(NOT_APPLICABLE)
  irn              String?        @unique
  ackNo            String?
  ackDate          DateTime?      @db.Timestamptz(3)
  signedQrCode     String?
  eInvoiceError    String?
  regionId         String?        @db.Uuid // stamped at issue for scope + MIS
  region           Region?        @relation(fields: [regionId], references: [id], onDelete: Restrict)
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @db.Timestamptz(3)

  lines           InvoiceLine[]
  allocations     PaymentAllocation[]
  adjustmentNotes AdjustmentNote[]
  promises        PaymentPromise[]

  @@unique([legalEntityId, invoiceNo])
  @@index([customerId, invoiceDate])
  @@index([status, dueDate])
  @@index([regionId, invoiceDate])
  @@index([salesOrderId])
  @@schema("core")
}

model InvoiceLine {
  id               String          @id @default(uuid(7)) @db.Uuid
  invoiceId        String          @db.Uuid
  invoice          Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  lineNo           Int
  salesOrderLineId String?         @db.Uuid
  salesOrderLine   SalesOrderLine? @relation(fields: [salesOrderLineId], references: [id], onDelete: Restrict)
  dispatchLineId   String?         @db.Uuid
  dispatchLine     DispatchLine?   @relation(fields: [dispatchLineId], references: [id], onDelete: Restrict)
  productId        String?         @db.Uuid
  product          Product?        @relation(fields: [productId], references: [id], onDelete: Restrict)
  description      String
  hsnCode          String
  quantity         Decimal         @db.Decimal(18, 3)
  uomId            String          @db.Uuid
  uom              UnitOfMeasure   @relation(fields: [uomId], references: [id], onDelete: Restrict)
  unitPrice        Decimal         @db.Decimal(18, 4)
  discountAmt      Decimal         @default(0) @db.Decimal(18, 2)
  taxableValue     Decimal         @db.Decimal(18, 2)
  gstRate          Decimal         @db.Decimal(5, 2)
  cgstAmount       Decimal         @default(0) @db.Decimal(18, 2)
  sgstAmount       Decimal         @default(0) @db.Decimal(18, 2)
  igstAmount       Decimal         @default(0) @db.Decimal(18, 2)
  cessAmount       Decimal         @default(0) @db.Decimal(18, 2)
  lineTotal        Decimal         @db.Decimal(18, 2)

  noteLines AdjustmentNoteLine[]

  @@unique([invoiceId, lineNo])
  @@index([hsnCode])
  @@schema("core")
}

// GST credit / debit notes against an issued invoice.
model AdjustmentNote {
  id             String         @id @default(uuid(7)) @db.Uuid
  noteNo         String
  noteType       NoteType
  legalEntityId  String         @db.Uuid
  legalEntity    LegalEntity    @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  customerId     String         @db.Uuid
  customer       Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  invoiceId      String         @db.Uuid
  invoice        Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  noteDate       DateTime       @db.Date
  reason         NoteReason
  reasonDetail   String?
  taxableTotal   Decimal        @db.Decimal(18, 2)
  cgstTotal      Decimal        @default(0) @db.Decimal(18, 2)
  sgstTotal      Decimal        @default(0) @db.Decimal(18, 2)
  igstTotal      Decimal        @default(0) @db.Decimal(18, 2)
  cessTotal      Decimal        @default(0) @db.Decimal(18, 2)
  roundOff       Decimal        @default(0) @db.Decimal(18, 2)
  grandTotal     Decimal        @db.Decimal(18, 2)
  status         InvoiceStatus  @default(DRAFT)
  issuedAt       DateTime?      @db.Timestamptz(3)
  cancelledAt    DateTime?      @db.Timestamptz(3)
  eInvoiceStatus EInvoiceStatus @default(NOT_APPLICABLE)
  irn            String?        @unique
  ackNo          String?
  ackDate        DateTime?      @db.Timestamptz(3)
  signedQrCode   String?
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)

  lines AdjustmentNoteLine[]

  @@unique([legalEntityId, noteType, noteNo])
  @@index([invoiceId])
  @@schema("core")
}

model AdjustmentNoteLine {
  id            String         @id @default(uuid(7)) @db.Uuid
  noteId        String         @db.Uuid
  note          AdjustmentNote @relation(fields: [noteId], references: [id], onDelete: Restrict)
  lineNo        Int
  invoiceLineId String?        @db.Uuid
  invoiceLine   InvoiceLine?   @relation(fields: [invoiceLineId], references: [id], onDelete: Restrict)
  productId     String?        @db.Uuid
  product       Product?       @relation(fields: [productId], references: [id], onDelete: Restrict)
  description   String
  hsnCode       String
  quantity      Decimal        @default(0) @db.Decimal(18, 3)
  taxableValue  Decimal        @db.Decimal(18, 2)
  gstRate       Decimal        @db.Decimal(5, 2)
  cgstAmount    Decimal        @default(0) @db.Decimal(18, 2)
  sgstAmount    Decimal        @default(0) @db.Decimal(18, 2)
  igstAmount    Decimal        @default(0) @db.Decimal(18, 2)
  cessAmount    Decimal        @default(0) @db.Decimal(18, 2)
  lineTotal     Decimal        @db.Decimal(18, 2)
  restock       Boolean        @default(false) // sales return → stock ledger SALES_RETURN

  @@unique([noteId, lineNo])
  @@schema("core")
}

model BankAccount {
  id              String         @id @default(uuid(7)) @db.Uuid
  legalEntityId   String         @db.Uuid
  legalEntity     LegalEntity    @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  name            String
  bankName        String
  accountNumber   String // the company's own account (printed on invoices)
  ifsc            String
  ledgerAccountId String         @db.Uuid
  ledgerAccount   LedgerAccount  @relation(fields: [ledgerAccountId], references: [id], onDelete: Restrict)
  showOnInvoice   Boolean        @default(false)
  active          Boolean        @default(true)

  receipts         PaymentReceipt[]
  supplierPayments SupplierPayment[]

  @@schema("core")
}

// Money received. Accounts VERIFY it (bank reconciled) before it counts
// toward PAYMENT_CONFIRMED.
model PaymentReceipt {
  id            String        @id @default(uuid(7)) @db.Uuid
  receiptNo     String
  legalEntityId String        @db.Uuid
  legalEntity   LegalEntity   @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  customerId    String        @db.Uuid
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  receivedOn    DateTime      @db.Date
  mode          PaymentMode
  amount        Decimal       @db.Decimal(18, 2)
  tdsDeducted   Decimal       @default(0) @db.Decimal(18, 2)
  bankAccountId String?       @db.Uuid
  bankAccount   BankAccount?  @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  referenceNo   String? // UTR / cheque no.
  chequeDate    DateTime?     @db.Date
  status        ReceiptStatus @default(RECORDED)
  verifiedById  String?       @db.Uuid
  verifiedBy    Employee?     @relation(fields: [verifiedById], references: [id], onDelete: Restrict)
  verifiedAt    DateTime?     @db.Timestamptz(3)
  notes         String?
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)

  allocations PaymentAllocation[]

  @@unique([legalEntityId, receiptNo])
  @@index([customerId, receivedOn])
  @@index([status])
  @@index([referenceNo])
  @@schema("core")
}

// Applies a receipt to an invoice, or to a sales order as an advance.
// Exactly one target (CHECK in SQL). When the invoice is issued, the advance
// allocation is reversed and re-applied to the invoice.
model PaymentAllocation {
  id             String         @id @default(uuid(7)) @db.Uuid
  receiptId      String         @db.Uuid
  receipt        PaymentReceipt @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  invoiceId      String?        @db.Uuid
  invoice        Invoice?       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  salesOrderId   String?        @db.Uuid
  salesOrder     SalesOrder?    @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  amount         Decimal        @db.Decimal(18, 2)
  tdsAmount      Decimal        @default(0) @db.Decimal(18, 2)
  allocatedAt    DateTime       @default(now()) @db.Timestamptz(3)
  reversedAt     DateTime?      @db.Timestamptz(3)
  reversalReason String?

  @@index([invoiceId])
  @@index([salesOrderId])
  @@index([receiptId])
  @@schema("core")
}

// Customer's promise to pay (collections follow-up).
model PaymentPromise {
  id           String        @id @default(uuid(7)) @db.Uuid
  customerId   String        @db.Uuid
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  invoiceId    String?       @db.Uuid
  invoice      Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  promisedDate DateTime      @db.Date
  amount       Decimal?      @db.Decimal(18, 2)
  status       PromiseStatus @default(OPEN)
  recordedById String        @db.Uuid
  recordedBy   Employee      @relation(fields: [recordedById], references: [id], onDelete: Restrict)
  note         String?
  resolvedAt   DateTime?     @db.Timestamptz(3)
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)

  @@index([customerId, status])
  @@index([promisedDate, status])
  @@schema("core")
}

model GstReturnFiling {
  id            String      @id @default(uuid(7)) @db.Uuid
  legalEntityId String      @db.Uuid
  legalEntity   LegalEntity @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  returnType    String // GSTR1 | GSTR3B | GSTR9
  periodStart   DateTime    @db.Date
  status        String      @default("draft") // draft | ready | filed
  arn           String?
  filedAt       DateTime?   @db.Timestamptz(3)
  summary       Json?
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)

  @@unique([legalEntityId, returnType, periodStart])
  @@schema("core")
}

// ═════════════════════════════════════════════════════════════════════════════
// 14. GENERAL LEDGER (double entry)
// ═════════════════════════════════════════════════════════════════════════════

model LedgerAccount {
  id            String            @id @default(uuid(7)) @db.Uuid
  legalEntityId String            @db.Uuid
  legalEntity   LegalEntity       @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  code          String
  name          String
  type          LedgerAccountType
  parentId      String?           @db.Uuid
  parent        LedgerAccount?    @relation("LedgerTree", fields: [parentId], references: [id], onDelete: Restrict)
  children      LedgerAccount[]   @relation("LedgerTree")
  systemKey     String? // AR | AP | SALES | OUTPUT_CGST | OUTPUT_SGST | OUTPUT_IGST | INPUT_* | ROUND_OFF | TDS_RECEIVABLE | INVENTORY | COGS
  isPostable    Boolean           @default(true) // groups are not postable
  active        Boolean           @default(true)

  journalLines JournalLine[]
  bankAccounts BankAccount[]

  @@unique([legalEntityId, code])
  @@unique([legalEntityId, systemKey])
  @@schema("core")
}

// Posted by the service layer from source documents (invoice issued, receipt
// verified, bill posted…). Balanced (Σ debit = Σ credit) and immutable —
// enforced by deferred constraint trigger. Corrections = reversal entries.
model JournalEntry {
  id             String        @id @default(uuid(7)) @db.Uuid
  entryNo        String
  legalEntityId  String        @db.Uuid
  legalEntity    LegalEntity   @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  entryDate      DateTime      @db.Date
  sourceDocType  String? // Invoice | AdjustmentNote | PaymentReceipt | SupplierBill | SupplierPayment | Manual
  sourceDocId    String?       @db.Uuid
  idempotencyKey String        @unique // e.g. "Invoice:<id>:issue" — a document posts once
  narration      String
  status         JournalStatus @default(POSTED)
  reversalOfId   String?       @unique @db.Uuid
  reversalOf     JournalEntry? @relation("JournalReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy     JournalEntry? @relation("JournalReversal")
  postedAt       DateTime      @default(now()) @db.Timestamptz(3)

  lines JournalLine[]

  @@unique([legalEntityId, entryNo])
  @@index([sourceDocType, sourceDocId])
  @@index([legalEntityId, entryDate])
  @@schema("core")
}

model JournalLine {
  id          String        @id @default(uuid(7)) @db.Uuid
  entryId     String        @db.Uuid
  entry       JournalEntry  @relation(fields: [entryId], references: [id], onDelete: Restrict)
  accountId   String        @db.Uuid
  account     LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  debit       Decimal       @default(0) @db.Decimal(18, 2)
  credit      Decimal       @default(0) @db.Decimal(18, 2)
  customerId  String?       @db.Uuid // sub-ledger
  customer    Customer?     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  supplierId  String?       @db.Uuid
  supplier    Supplier?     @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  description String?

  @@index([entryId])
  @@index([accountId])
  @@index([customerId])
  @@index([supplierId])
  @@schema("core")
}

// ═════════════════════════════════════════════════════════════════════════════
// 15. WORK: actions (tasks) + escalation
// ═════════════════════════════════════════════════════════════════════════════

// Every department's unit of work, with a due time and an escalation policy.
// The escalation sweeper (SystemJobRun key "escalation-sweep") picks rows
// where status is open and nextEscalationAt <= now(), applies the next
// EscalationStep, notifies, and sets the following nextEscalationAt.
model BusinessAction {
  id                 String             @id @default(uuid(7)) @db.Uuid
  actionNo           Int                @unique @default(autoincrement()) // ACT-000123
  category           String // estimate_followup | collect_payment | verify_order | confirm_stock | schedule_dispatch | qualify_enquiry ...
  title              String
  description        String?
  departmentId       String             @db.Uuid
  department         Department         @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  assigneeId         String?            @db.Uuid
  assignee           Employee?          @relation("ActionAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  assignedPositionId String?            @db.Uuid // queue: anyone holding this position
  assignedPosition   Position?          @relation(fields: [assignedPositionId], references: [id], onDelete: Restrict)
  assignedTeamId     String?            @db.Uuid
  assignedTeam       Team?              @relation(fields: [assignedTeamId], references: [id], onDelete: Restrict)
  creatorType        ActorType          @default(EMPLOYEE)
  creatorId          String?            @db.Uuid
  creator            Employee?          @relation("ActionCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  priority           ActionPriority     @default(MEDIUM)
  status             ActionStatus       @default(OPEN)
  dueAt              DateTime?          @db.Timestamptz(3)
  startedAt          DateTime?          @db.Timestamptz(3)
  completedAt        DateTime?          @db.Timestamptz(3)
  completedById      String?            @db.Uuid
  completedBy        Employee?          @relation("ActionCompleter", fields: [completedById], references: [id], onDelete: Restrict)
  outcome            String?
  completionNote     String?
  entityType         String? // what the work is about
  entityId           String?            @db.Uuid
  customerId         String?            @db.Uuid // for the customer timeline
  customer           Customer?          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  parentId           String?            @db.Uuid
  parent             BusinessAction?    @relation("ActionTree", fields: [parentId], references: [id], onDelete: Restrict)
  children           BusinessAction[]   @relation("ActionTree")
  escalationPolicyId String?            @db.Uuid
  escalationPolicy   EscalationPolicy?  @relation(fields: [escalationPolicyId], references: [id], onDelete: Restrict)
  escalationLevel    Int                @default(0)
  nextEscalationAt   DateTime?          @db.Timestamptz(3)
  lastEscalatedAt    DateTime?          @db.Timestamptz(3)
  sourceType         String? // what created it: StageGate | AutomationRule | Manual | Legacy:<table>
  sourceId           String?
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(3)
  version            Int                @default(1)

  events     BusinessActionEvent[]
  dataIssues DataQualityIssue[]

  @@unique([sourceType, sourceId])
  @@index([assigneeId, status, dueAt])
  @@index([departmentId, status, dueAt])
  @@index([assignedPositionId, status])
  @@index([status, nextEscalationAt])
  @@index([entityType, entityId])
  @@index([customerId, status])
  @@schema("core")
}

model BusinessActionEvent {
  id              String          @id @default(uuid(7)) @db.Uuid
  actionId        String          @db.Uuid
  action          BusinessAction  @relation(fields: [actionId], references: [id], onDelete: Restrict)
  type            ActionEventType
  fromStatus      ActionStatus?
  toStatus        ActionStatus?
  fromAssigneeId  String?         @db.Uuid
  toAssigneeId    String?         @db.Uuid
  escalationLevel Int?
  note            String?
  data            Json?
  actorType       ActorType       @default(EMPLOYEE)
  actorEmployeeId String?         @db.Uuid
  actorEmployee   Employee?       @relation(fields: [actorEmployeeId], references: [id], onDelete: Restrict)
  occurredAt      DateTime        @default(now()) @db.Timestamptz(3)

  @@index([actionId, occurredAt])
  @@index([type, occurredAt])
  @@schema("core")
}

// "A sales follow-up overdue by 4h → remind; by 24h → TL; by 48h → Sales Head."
// Matched to actions by category (and optionally department/priority).
model EscalationPolicy {
  id           String          @id @default(uuid(7)) @db.Uuid
  key          String          @unique
  name         String
  category     String? // BusinessAction.category it applies to; null = default for department
  departmentId String?         @db.Uuid
  department   Department?     @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  priority     ActionPriority?
  active       Boolean         @default(true)
  createdAt    DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @db.Timestamptz(3)

  steps   EscalationStep[]
  actions BusinessAction[]

  @@schema("core")
}

model EscalationStep {
  id               String                @id @default(uuid(7)) @db.Uuid
  policyId         String                @db.Uuid
  policy           EscalationPolicy      @relation(fields: [policyId], references: [id], onDelete: Restrict)
  level            Int // 1, 2, 3 ...
  afterMinutes     Int // minutes after dueAt
  target           EscalationTarget
  targetPositionId String?               @db.Uuid
  targetPosition   Position?             @relation(fields: [targetPositionId], references: [id], onDelete: Restrict)
  targetEmployeeId String?               @db.Uuid
  targetEmployee   Employee?             @relation(fields: [targetEmployeeId], references: [id], onDelete: Restrict)
  reassign         Boolean               @default(false) // move the action to the target, not just notify
  raisePriority    ActionPriority?
  channels         NotificationChannel[] @default([])
  templateKey      String // NotificationTemplate.key

  @@unique([policyId, level])
  @@schema("core")
}

// Observability for scheduled core jobs (escalation sweep, reservation
// expiry, period close checks, e-invoice retry).
model SystemJobRun {
  id         String       @id @default(uuid(7)) @db.Uuid
  jobKey     String
  status     JobRunStatus @default(RUNNING)
  startedAt  DateTime     @default(now()) @db.Timestamptz(3)
  finishedAt DateTime?    @db.Timestamptz(3)
  stats      Json?
  error      String?

  @@index([jobKey, startedAt])
  @@schema("core")
}

// ═════════════════════════════════════════════════════════════════════════════
// 16. APPROVALS
// ═════════════════════════════════════════════════════════════════════════════

// Which approvals apply when, and who approves at each stage.
model ApprovalPolicy {
  id           String       @id @default(uuid(7)) @db.Uuid
  key          String       @unique // discount_over_5pct | order_verification | credit_over_limit ...
  name         String
  approvalType ApprovalType
  entityType   String
  condition    Json? // evaluated by the core service, e.g. {"discountPct": {"gt": 5}}
  priority     Int          @default(100)
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(3)

  stages   ApprovalPolicyStage[]
  requests ApprovalRequest[]

  @@index([approvalType, entityType, active])
  @@schema("core")
}

model ApprovalPolicyStage {
  id           String         @id @default(uuid(7)) @db.Uuid
  policyId     String         @db.Uuid
  policy       ApprovalPolicy @relation(fields: [policyId], references: [id], onDelete: Restrict)
  stage        Int
  approverType ApproverType
  positionId   String?        @db.Uuid
  position     Position?      @relation(fields: [positionId], references: [id], onDelete: Restrict)
  roleId       String?        @db.Uuid
  role         Role?          @relation(fields: [roleId], references: [id], onDelete: Restrict)
  employeeId   String?        @db.Uuid
  employee     Employee?      @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  slaMinutes   Int? // escalates like an action when exceeded

  @@unique([policyId, stage])
  @@schema("core")
}

// Stores the exact proposed change and the record version it was based on;
// a stale request (record changed since) is never executed.
model ApprovalRequest {
  id                String          @id @default(uuid(7)) @db.Uuid
  requestNo         Int             @unique @default(autoincrement()) // APR-000123
  policyId          String?         @db.Uuid
  policy            ApprovalPolicy? @relation(fields: [policyId], references: [id], onDelete: Restrict)
  approvalType      ApprovalType
  status            ApprovalStatus  @default(PENDING)
  title             String
  reason            String?
  departmentId      String          @db.Uuid
  department        Department      @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  entityType        String
  entityId          String          @db.Uuid
  proposedChange    Json?
  baseVersion       Int? // entity.version when raised
  amount            Decimal?        @db.Decimal(18, 2)
  requestedById     String          @db.Uuid
  requestedBy       Employee        @relation("ApprovalRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  currentStage      Int             @default(1)
  totalStages       Int             @default(1)
  currentApproverId String?         @db.Uuid
  currentApprover   Employee?       @relation("ApprovalCurrentApprover", fields: [currentApproverId], references: [id], onDelete: Restrict)
  dueAt             DateTime?       @db.Timestamptz(3)
  decidedAt         DateTime?       @db.Timestamptz(3)
  executedAt        DateTime?       @db.Timestamptz(3)
  executionResult   Json?
  executionError    String?
  idempotencyKey    String?         @unique
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @db.Timestamptz(3)

  events              ApprovalEvent[]
  stageEvents         SalesOrderStageEvent[]
  integrationCommands IntegrationCommand[]

  @@index([status, currentApproverId])
  @@index([entityType, entityId, approvalType, status])
  @@index([requestedById, createdAt])
  @@schema("core")
}

model ApprovalEvent {
  id              String            @id @default(uuid(7)) @db.Uuid
  requestId       String            @db.Uuid
  request         ApprovalRequest   @relation(fields: [requestId], references: [id], onDelete: Restrict)
  stage           Int               @default(1)
  type            ApprovalEventType
  actorType       ActorType         @default(EMPLOYEE)
  actorEmployeeId String?           @db.Uuid
  actorEmployee   Employee?         @relation(fields: [actorEmployeeId], references: [id], onDelete: Restrict)
  note            String?
  data            Json?
  occurredAt      DateTime          @default(now()) @db.Timestamptz(3)

  @@index([requestId, occurredAt])
  @@schema("core")
}

// ═════════════════════════════════════════════════════════════════════════════
// 17. NOTIFICATIONS
// ═════════════════════════════════════════════════════════════════════════════

model NotificationTemplate {
  id              String              @id @default(uuid(7)) @db.Uuid
  key             String // action_assigned | action_overdue | escalated_to_you | approval_needed | stage_changed ...
  channel         NotificationChannel
  locale          String              @default("en")
  subject         String?
  body            String // {{placeholders}}
  waTemplateName  String? // pre-approved WhatsApp template
  waLanguage      String?
  variables       String[] @default([])
  active          Boolean             @default(true)
  updatedAt       DateTime            @updatedAt @db.Timestamptz(3)

  @@unique([key, channel, locale])
  @@schema("core")
}

model NotificationPreference {
  id           String              @id @default(uuid(7)) @db.Uuid
  employeeId   String              @db.Uuid
  employee     Employee            @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  category     String              @default("*") // template key or "*"
  channel      NotificationChannel
  enabled      Boolean             @default(true)
  quietFromMin Int? // minutes after midnight IST
  quietToMin   Int?
  updatedAt    DateTime            @updatedAt @db.Timestamptz(3)

  @@unique([employeeId, category, channel])
  @@schema("core")
}

model Notification {
  id          String         @id @default(uuid(7)) @db.Uuid
  recipientId String         @db.Uuid
  recipient   Employee       @relation(fields: [recipientId], references: [id], onDelete: Restrict)
  templateKey String
  title       String
  body        String?
  priority    ActionPriority @default(MEDIUM)
  entityType  String?
  entityId    String?        @db.Uuid
  link        String?
  dedupKey    String?        @unique // e.g. "overdue:<actionId>:L2" — one per action per level
  readAt      DateTime?      @db.Timestamptz(3)
  archivedAt  DateTime?      @db.Timestamptz(3)
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)

  deliveries NotificationDelivery[]

  @@index([recipientId, readAt, createdAt])
  @@schema("core")
}

model NotificationDelivery {
  id                String              @id @default(uuid(7)) @db.Uuid
  notificationId    String              @db.Uuid
  notification      Notification        @relation(fields: [notificationId], references: [id], onDelete: Restrict)
  channel           NotificationChannel
  status            DeliveryStatus      @default(QUEUED)
  destination       String?
  providerMessageId String?
  attempts          Int                 @default(0)
  nextAttemptAt     DateTime?           @db.Timestamptz(3)
  lastError         String?
  sentAt            DateTime?           @db.Timestamptz(3)
  deliveredAt       DateTime?           @db.Timestamptz(3)
  readAt            DateTime?           @db.Timestamptz(3)
  createdAt         DateTime            @default(now()) @db.Timestamptz(3)

  @@unique([notificationId, channel])
  @@index([status, nextAttemptAt])
  @@schema("core")
}

// ═════════════════════════════════════════════════════════════════════════════
// 18. DATA QUALITY
// ═════════════════════════════════════════════════════════════════════════════

model DataQualityIssue {
  id           String          @id @default(uuid(7)) @db.Uuid
  ruleKey      String
  fingerprint  String          @unique // ruleKey|entityType|entityId|field
  severity     IssueSeverity   @default(MEDIUM)
  status       IssueStatus     @default(OPEN)
  entityType   String
  entityId     String
  fieldName    String?
  description  String
  details      Json?
  assigneeId   String?         @db.Uuid
  assignee     Employee?       @relation("IssueAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  actionId     String?         @db.Uuid
  action       BusinessAction? @relation(fields: [actionId], references: [id], onDelete: Restrict)
  detectedAt   DateTime        @default(now()) @db.Timestamptz(3)
  lastSeenAt   DateTime        @default(now()) @db.Timestamptz(3)
  resolvedAt   DateTime?       @db.Timestamptz(3)
  resolvedById String?         @db.Uuid
  resolvedBy   Employee?       @relation("IssueResolver", fields: [resolvedById], references: [id], onDelete: Restrict)

  @@index([status, severity])
  @@index([entityType, entityId])
  @@schema("core")
}

// ═════════════════════════════════════════════════════════════════════════════
// 19. INTEGRATIONS (GSP for e-invoice / e-way bill, NeoDove, WhatsApp, n8n)
// ═════════════════════════════════════════════════════════════════════════════

model IntegrationConnection {
  id            String    @id @default(uuid(7)) @db.Uuid
  provider      String // gsp | neodove | waba | n8n | google
  namespace     String    @default("") // e.g. legal entity code for per-GSTIN GSP credentials
  label         String?
  secretRef     String // name of the secret in the secret store — never the secret
  scopes        String[] @default([])
  status        String    @default("active")
  expiresAt     DateTime? @db.Timestamptz(3)
  lastHealthyAt DateTime? @db.Timestamptz(3)
  lastError     String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([provider, namespace])
  @@schema("core")
}

model IntegrationEvent {
  id              String                 @id @default(uuid(7)) @db.Uuid
  provider        String
  eventType       String
  externalEventId String?
  idempotencyKey  String                 @unique
  payload         Json
  headers         Json?
  signatureValid  Boolean?
  status          IntegrationEventStatus @default(RECEIVED)
  attempts        Int                    @default(0)
  error           String?
  receivedAt      DateTime               @default(now()) @db.Timestamptz(3)
  processedAt     DateTime?              @db.Timestamptz(3)

  @@index([provider, status, receivedAt])
  @@schema("core")
}

// Outbound calls (generate IRN, generate e-way bill, send WhatsApp, create
// NeoDove lead). Nothing is assumed done until SUCCEEDED with a response.
model IntegrationCommand {
  id                String                   @id @default(uuid(7)) @db.Uuid
  provider          String
  commandType       String // gsp.einvoice.generate | gsp.ewaybill.generate | waba.send | neodove.lead.create
  entityType        String?
  entityId          String?                  @db.Uuid
  payload           Json
  idempotencyKey    String                   @unique
  status            IntegrationCommandStatus @default(QUEUED)
  attempts          Int                      @default(0)
  maxAttempts       Int                      @default(5)
  nextAttemptAt     DateTime?                @db.Timestamptz(3)
  lastError         String?
  response          Json?
  externalRef       String?
  requestedById     String?                  @db.Uuid
  requestedBy       Employee?                @relation(fields: [requestedById], references: [id], onDelete: Restrict)
  approvalRequestId String?                  @db.Uuid
  approvalRequest   ApprovalRequest?         @relation(fields: [approvalRequestId], references: [id], onDelete: Restrict)
  createdAt         DateTime                 @default(now()) @db.Timestamptz(3)
  sentAt            DateTime?                @db.Timestamptz(3)
  confirmedAt       DateTime?                @db.Timestamptz(3)
  updatedAt         DateTime                 @updatedAt @db.Timestamptz(3)

  @@index([status, nextAttemptAt])
  @@index([entityType, entityId])
  @@schema("core")
}

model IntegrationSyncState {
  id                String     @id @default(uuid(7)) @db.Uuid
  provider          String
  namespace         String     @default("")
  resource          String
  cursor            String?
  status            SyncStatus @default(IDLE)
  lastAttemptAt     DateTime?  @db.Timestamptz(3)
  lastSuccessAt     DateTime?  @db.Timestamptz(3)
  lastError         String?
  consecutiveErrors Int        @default(0)
  staleAfterMinutes Int        @default(60)
  updatedAt         DateTime   @updatedAt @db.Timestamptz(3)

  @@unique([provider, namespace, resource])
  @@schema("core")
}
