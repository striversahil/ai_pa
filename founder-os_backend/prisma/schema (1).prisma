  lastSeenAt   DateTime?
  appVersion   String    @default("")
  pairedBy     String    @default("")
  pairedByName String    @default("")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  revokedAt    DateTime?
  revokedBy    String    @default("")

