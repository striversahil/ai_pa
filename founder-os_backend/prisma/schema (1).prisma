// ── 1. Organisation foundation ───────────────────────────────────────────────

// The single employee identity. Legacy rosters (Telecaller, HumanResourcesMember,
// Accountant, DigitalMarketingManager) and the login (AuthUser) each point here
// through a unique employeeId, so one person can never become two employees.
// Sensitive HR/payroll fields (PAN, bank, salary) deliberately stay in
// HumanResourcesMember, which is HR-owned and permission-restricted.
model Employee {
  id             String         @id @default(uuid())
  employeeCode   String?        @unique
  fullName       String
  displayName    String?
  workEmail      String?        @unique
  phoneE164      String?
  whatsappE164   String?
  status         EmployeeStatus @default(ACTIVE)
  employmentType String? // full_time | part_time | contract | intern
  joiningDate    DateTime?      @db.Date
  exitDate       DateTime?      @db.Date
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)

  // legacy identity links (each legacy table holds the FK)
  authUser         AuthUser?
  telecaller       Telecaller?
  hrMember         HumanResourcesMember?
  accountant       Accountant?
  marketingManager DigitalMarketingManager?

  // organisation history
  departmentAssignments EmployeeDepartmentAssignment[]
  positionAssignments   EmployeePositionAssignment[]
  regionAssignments     EmployeeRegionAssignment[]
  teamMemberships       TeamMembership[]
  reportingLines        EmployeeReportingLine[]        @relation("ReportingEmployee")
  directReports         EmployeeReportingLine[]        @relation("ReportingManager")

  // CRM
  customersCreated        Customer[]           @relation("CustomerCreatedBy")
  customerAssignments     CustomerAssignment[] @relation("CustomerAssignee")
  customerAssignmentsMade CustomerAssignment[] @relation("CustomerAssignedBy")
  customerActivities      CustomerActivity[]
  customerNotes           CustomerNote[]

  // work, governance, approvals
  actionsAssigned     BusinessAction[]      @relation("ActionAssignee")
  actionsCreated      BusinessAction[]      @relation("ActionCreator")
  actionsCompleted    BusinessAction[]      @relation("ActionCompleter")
  actionEvents        BusinessActionEvent[]
  auditEvents         AuditEvent[]
  permissionRules     DataPermissionRule[]
  approvalsRequested  ApprovalRequest[]     @relation("ApprovalRequester")
  approvalsAwaiting   ApprovalRequest[]     @relation("ApprovalCurrentApprover")
  approvalEvents      ApprovalEvent[]
  notifications       Notification[]
  workflowsStarted    WorkflowInstance[]
  dataIssuesAssigned  DataQualityIssue[]    @relation("IssueAssignee")
  dataIssuesResolved  DataQualityIssue[]    @relation("IssueResolver")
  integrationCommands IntegrationCommand[]

  @@index([status])
  @@index([fullName])
}

model Department {
  id        String       @id @default(uuid())
  code      String       @unique // SALES | CRM | ACCOUNTS | HR | PURCHASE | INVENTORY | DISPATCH | MARKETING | MANAGEMENT
  name      String
  parentId  String?
  parent    Department?  @relation("DepartmentTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  Department[] @relation("DepartmentTree")
  active    Boolean      @default(true)
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @db.Timestamptz(3)

  positions           Position[]
  teams               Team[]
  employeeAssignments EmployeeDepartmentAssignment[]
  actions             BusinessAction[]
  approvals           ApprovalRequest[]
  workflowDefinitions WorkflowDefinition[]
  dataOwnerships      DataOwnership[]
  permissionRules     DataPermissionRule[]
  entityDefinitions   DataEntityDefinition[]
}

// Job role in the hierarchy (Founder, Head, TL1, TL2, Telecaller, Field
// Executive, Accountant…). Not the same as HumanResourcesHiringPosition, which
// is the hiring-kit document folder and stays as it is.
model Position {
  id           String      @id @default(uuid())
  code         String      @unique // FOUNDER | DEPT_HEAD | TL1 | TL2 | TELECALLER | FIELD_EXEC | ACCOUNTANT_SR | ACCOUNTANT_JR ...
  name         String
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  rank         Int         @default(100) // lower = more senior; used for escalation
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime    @updatedAt @db.Timestamptz(3)

  assignments     EmployeePositionAssignment[]
  actions         BusinessAction[]
  permissionRules DataPermissionRule[]
}

model Team {
  id           String     @id @default(uuid())
  code         String     @unique
  name         String
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  regionId     String?
  region       Region?    @relation(fields: [regionId], references: [id], onDelete: Restrict)
  parentId     String?
  parent       Team?      @relation("TeamTree", fields: [parentId], references: [id], onDelete: Restrict)
  children     Team[]     @relation("TeamTree")
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(3)

  memberships         TeamMembership[]
  customerAssignments CustomerAssignment[]
  actions             BusinessAction[]

  @@index([departmentId])
}

// Sales regions. code matches the legacy strings already stored on Estimate,
// Telecaller, CrmSalesOrder, PaymentCustomer and DebtorInvoice ('R1'–'R4'),
// so legacy rows can be joined on code until they get a real regionId.
model Region {
  id        String   @id @default(uuid())
  code      String   @unique // R1 | R2 | R3 | R4
  name      String
  states    String[] // Indian states/UTs covered, for routing new customers
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  employeeAssignments EmployeeRegionAssignment[]
  teams               Team[]
  customerAssignments CustomerAssignment[]
}

model EmployeeDepartmentAssignment {
  id           String     @id @default(uuid())
  employeeId   String
  employee     Employee   @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  isPrimary    Boolean    @default(true)
  validFrom    DateTime   @default(now()) @db.Timestamptz(3)
  validTo      DateTime?  @db.Timestamptz(3)
  reason       String?
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)

  @@index([employeeId, validTo])
  @@index([departmentId, validTo])
}

model EmployeePositionAssignment {
  id         String    @id @default(uuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  positionId String
  position   Position  @relation(fields: [positionId], references: [id], onDelete: Restrict)
  isPrimary  Boolean   @default(true)
  validFrom  DateTime  @default(now()) @db.Timestamptz(3)
  validTo    DateTime? @db.Timestamptz(3)
  reason     String?
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  @@index([employeeId, validTo])
  @@index([positionId, validTo])
}

// TL1s hold two regions at once (founder rule 2026-11-05) → one PRIMARY + one
// SECONDARY open row. Replaces Telecaller.region / Telecaller.region2.
model EmployeeRegionAssignment {
  id             String               @id @default(uuid())
  employeeId     String
  employee       Employee             @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  regionId       String
  region         Region               @relation(fields: [regionId], references: [id], onDelete: Restrict)
  responsibility RegionResponsibility @default(PRIMARY)
  validFrom      DateTime             @default(now()) @db.Timestamptz(3)
  validTo        DateTime?            @db.Timestamptz(3)
  reason         String?
  createdAt      DateTime             @default(now()) @db.Timestamptz(3)

  @@index([employeeId, validTo])
  @@index([regionId, validTo])
}

model TeamMembership {
  id         String    @id @default(uuid())
  teamId     String
  team       Team      @relation(fields: [teamId], references: [id], onDelete: Restrict)
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  role       TeamRole  @default(MEMBER)
  validFrom  DateTime  @default(now()) @db.Timestamptz(3)
  validTo    DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  @@index([teamId, validTo])
  @@index([employeeId, validTo])
}

model EmployeeReportingLine {
  id         String            @id @default(uuid())
  employeeId String
  employee   Employee          @relation("ReportingEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  managerId  String
  manager    Employee          @relation("ReportingManager", fields: [managerId], references: [id], onDelete: Restrict)
  type       ReportingLineType @default(DIRECT)
  validFrom  DateTime          @default(now()) @db.Timestamptz(3)
  validTo    DateTime?         @db.Timestamptz(3)
  createdAt  DateTime          @default(now()) @db.Timestamptz(3)

  @@index([employeeId, validTo])
  @@index([managerId, validTo])
}

// ── 2. Canonical customer master ─────────────────────────────────────────────

// One row per real business. Replaces the five places a customer is identified
// today: Estimate.customerName, Enquiry.clientCompany, CrmSalesOrder.customerId
// (Zoho), PaymentCustomer.customerKey and DebtorInvoice.customerName.
// Duplicates are never deleted: the loser gets status MERGED + mergedIntoId.
model Customer {
  id             String         @id @default(uuid())
  customerNo     Int            @unique @default(autoincrement()) // display as CUS-000123
  legalName      String
  displayName    String
  normalizedName String // lowercase, punctuation/suffix stripped — matching key, NOT unique
  gstin          String?        @unique
  pan            String?
  customerType   String? // mill | trader | dealer | oem | other
  status         CustomerStatus @default(PROSPECT)
  source         String? // first acquisition channel: TL | AI | Incoming | B2B | Field Staff | Marketing
  website        String?
  mergedIntoId   String?
  mergedInto     Customer?      @relation("CustomerMerge", fields: [mergedIntoId], references: [id], onDelete: Restrict)
  mergedFrom     Customer[]     @relation("CustomerMerge")
  mergedAt       DateTime?      @db.Timestamptz(3)
  createdById    String?
  createdBy      Employee?      @relation("CustomerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)
  version        Int            @default(1) // optimistic concurrency + approval staleness check

  contacts           CustomerContact[]
  addresses          CustomerAddress[]
  externalIdentities CustomerExternalIdentity[]
  assignments        CustomerAssignment[]
  activities         CustomerActivity[]
  notes              CustomerNote[]
  tagAssignments     CustomerTagAssignment[]

  // links from existing department tables
  enquiries          Enquiry[]
  estimates          Estimate[]
  salesOrders        CrmSalesOrder[]
  debtorInvoices     DebtorInvoice[]
  paymentCollections PaymentCollection[]
  paymentCustomers   PaymentCustomer[]
  marketingLeads     MarketingLead[]
  fieldMillVisits    FieldMillVisit[]

  actions   BusinessAction[]
  approvals ApprovalRequest[]

  @@index([normalizedName])
  @@index([status])
  @@index([mergedIntoId])
}

model CustomerContact {
  id            String      @id @default(uuid())
  customerId    String
  customer      Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  name          String
  designation   String?
  role          ContactRole @default(OTHER)
  phoneE164     String?
  whatsappE164  String?
  email         String?
  isPrimary     Boolean     @default(false)
  whatsappOptIn Boolean     @default(false)
  optInAt       DateTime?   @db.Timestamptz(3)
  verifiedAt    DateTime?   @db.Timestamptz(3)
  active        Boolean     @default(true)
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @db.Timestamptz(3)

  activities CustomerActivity[]

  @@index([customerId])
  @@index([phoneE164])
  @@index([whatsappE164])
  @@index([email])
}

// Offices, plants/mills, billing and delivery addresses. A mill is a PLANT
// address; its machine profile (roller plants, chakki count/size, brand,
// running time) lives in millProfile, fed by FieldMillVisit.
model CustomerAddress {
  id                String      @id @default(uuid())
  customerId        String
  customer          Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  type              AddressType
  label             String? // mill / plant / branch name
  line1             String
  line2             String?
  city              String?
  district          String?
  state             String?
  stateCode         String? // GST state code
  pincode           String?
  country           String      @default("IN")
  gstin             String? // branch GSTIN can differ by state
  latitude          Float?
  longitude         Float?
  millProfile       Json?
  isDefaultBilling  Boolean     @default(false)
  isDefaultShipping Boolean     @default(false)
  active            Boolean     @default(true)
  createdAt         DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime    @updatedAt @db.Timestamptz(3)

  fieldMillVisits FieldMillVisit[]

  @@index([customerId, type])
  @@index([state])
}

// Zoho contact ids per organisation (BUI and DPG are separate Zoho orgs that
// share one login), NeoDove lead ids, WhatsApp chat ids, legacy name keys.
model CustomerExternalIdentity {
  id             String         @id @default(uuid())
  customerId     String
  customer       Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  system         ExternalSystem
  organizationId String         @default("") // Zoho org; '' for single-tenant systems
  externalId     String
  externalName   String?
  isPrimary      Boolean        @default(true)
  linkedAt       DateTime       @default(now()) @db.Timestamptz(3)
  lastSyncedAt   DateTime?      @db.Timestamptz(3)

  @@unique([system, organizationId, externalId])
  @@index([customerId])
}

model CustomerAssignment {
  id           String                @id @default(uuid())
  customerId   String
  customer     Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  role         CustomerOwnershipRole @default(ACCOUNT_OWNER)
  employeeId   String?
  employee     Employee?             @relation("CustomerAssignee", fields: [employeeId], references: [id], onDelete: Restrict)
  teamId       String?
  team         Team?                 @relation(fields: [teamId], references: [id], onDelete: Restrict)
  regionId     String?
  region       Region?               @relation(fields: [regionId], references: [id], onDelete: Restrict)
  validFrom    DateTime              @default(now()) @db.Timestamptz(3)
  validTo      DateTime?             @db.Timestamptz(3)
  reason       String?
  assignedById String?
  assignedBy   Employee?             @relation("CustomerAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  createdAt    DateTime              @default(now()) @db.Timestamptz(3)

  @@index([customerId, role, validTo])
  @@index([employeeId, validTo])
  @@index([regionId, validTo])
  @@index([teamId, validTo])
}

// The customer timeline. Imported activity (NeoDove calls, DeviceCall rows,
// field mill visits, WhatsApp messages) is idempotent on
// (sourceSystem, sourceType, sourceId) so re-syncs never duplicate.
model CustomerActivity {
  id           String             @id @default(uuid())
  customerId   String
  customer     Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  contactId    String?
  contact      CustomerContact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  employeeId   String?
  employee     Employee?          @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  type         ActivityType
  direction    ActivityDirection?
  subject      String?
  body         String?
  outcome      String? // connected | not_answering | busy | callback | interested | order | ...
  durationSec  Int?
  occurredAt   DateTime           @db.Timestamptz(3)
  sourceSystem String             @default("BUI") // BUI | NEODOVE | DEVICE | WHATSAPP | FIELD
  sourceType   String? // e.g. DeviceCall, FieldMillVisit, Message
  sourceId     String?
  recordingRef String? // pointer only; NeoDove/device remains owner of the recording
  metadata     Json?
  createdAt    DateTime           @default(now()) @db.Timestamptz(3)

  @@unique([sourceSystem, sourceType, sourceId])
  @@index([customerId, occurredAt])
  @@index([employeeId, occurredAt])
  @@index([type, occurredAt])
}

model CustomerNote {
  id         String    @id @default(uuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  authorId   String?
  author     Employee? @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body       String
  pinned     Boolean   @default(false)
  visibility String    @default("internal") // internal | sales | accounts | management
  deletedAt  DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  @@index([customerId, createdAt])
}

model CustomerTag {
  id        String   @id @default(uuid())
  key       String   @unique
  label     String
  category  String? // segment | risk | product_interest | lifecycle
  color     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  assignments CustomerTagAssignment[]
}

model CustomerTagAssignment {
  customerId String
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tagId      String
  tag        CustomerTag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt  DateTime    @default(now()) @db.Timestamptz(3)

  @@id([customerId, tagId])
  @@index([tagId])
}

// ── 3. Universal action engine ───────────────────────────────────────────────

// Every department's unit of work. Legacy task tables (HumanResourcesTask,
// AccountsTaskLog, FieldFollowup, ChatPendingItem, WaTask, Task,
// DigitalMarketingOpenTask) are bridged with (legacySource, legacyId) — one
// action per legacy row, never two — until the legacy tables are retired.
model BusinessAction {
  id                 String            @id @default(uuid())
  actionNo           Int               @unique @default(autoincrement()) // display as ACT-000123
  title              String
  description        String?
  departmentId       String
  department         Department        @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  assigneeId         String?
  assignee           Employee?         @relation("ActionAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  assignedPositionId String? // queue-style assignment to a role
  assignedPosition   Position?         @relation(fields: [assignedPositionId], references: [id], onDelete: Restrict)
  assignedTeamId     String?
  assignedTeam       Team?             @relation(fields: [assignedTeamId], references: [id], onDelete: Restrict)
  creatorType        ActorType         @default(EMPLOYEE)
  creatorId          String?
  creator            Employee?         @relation("ActionCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  priority           Priority          @default(medium)
  status             ActionStatus      @default(OPEN)
  dueAt              DateTime?         @db.Timestamptz(3)
  startedAt          DateTime?         @db.Timestamptz(3)
  completedAt        DateTime?         @db.Timestamptz(3)
  completedById      String?
  completedBy        Employee?         @relation("ActionCompleter", fields: [completedById], references: [id], onDelete: SetNull)
  completionNote     String?
  outcome            String?
  // what this work is about (polymorphic, resolved through DataEntityDefinition)
  entityType         String? // Estimate | Enquiry | CrmSalesOrder | DebtorInvoice | Customer | StockItem | Employee ...
  entityId           String?
  customerId         String? // denormalised for the customer timeline + "my customers" queries
  customer           Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  sourceModule       String            @default("manual") // estimates | crm | accounts | hr | dispatch | purchase | marketing | workflow | manual
  legacySource       String? // HumanResourcesTask | AccountsTaskLog | FieldFollowup | ChatPendingItem | WaTask | Task | DigitalMarketingOpenTask
  legacyId           String?
  parentId           String?
  parent             BusinessAction?   @relation("ActionTree", fields: [parentId], references: [id], onDelete: Restrict)
  children           BusinessAction[]  @relation("ActionTree")
  workflowInstanceId String?
  workflowInstance   WorkflowInstance? @relation(fields: [workflowInstanceId], references: [id], onDelete: SetNull)
  escalationLevel    Int               @default(0)
  lastEscalatedAt    DateTime?         @db.Timestamptz(3)
  version            Int               @default(1)
  createdAt          DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @db.Timestamptz(3)

  events       BusinessActionEvent[]
  workflowStep WorkflowStep?
  dataIssues   DataQualityIssue[]

  @@unique([legacySource, legacyId])
  @@index([assigneeId, status, dueAt])
  @@index([departmentId, status, dueAt])
  @@index([assignedPositionId, status])
  @@index([assignedTeamId, status])
  @@index([entityType, entityId])
  @@index([customerId, status])
  @@index([status, dueAt])
}

model BusinessActionEvent {
  id              String          @id @default(uuid())
  actionId        String
  action          BusinessAction  @relation(fields: [actionId], references: [id], onDelete: Restrict)
  type            ActionEventType
  fromStatus      ActionStatus?
  toStatus        ActionStatus?
  fromAssigneeId  String?
  toAssigneeId    String?
  note            String?
  data            Json?
  actorType       ActorType       @default(EMPLOYEE)
  actorEmployeeId String?
  actorEmployee   Employee?       @relation(fields: [actorEmployeeId], references: [id], onDelete: SetNull)
  occurredAt      DateTime        @default(now()) @db.Timestamptz(3)

  @@index([actionId, occurredAt])
  @@index([actorEmployeeId, occurredAt])
}

// ── 4. Governance: ownership, permissions, audit ─────────────────────────────

// Field-level single-source-of-truth register. fieldName '*' = whole entity
// default; a specific field overrides it. The app's write path checks this
// before any update: READ_ONLY_MIRROR fields are rejected, WRITE_VIA_COMMAND
// fields become an IntegrationCommand.
model DataOwnership {
  id                String      @id @default(uuid())
  entityType        String // Estimate | CrmSalesOrder | Customer | DebtorInvoice | StockItem ...
  fieldName         String      @default("*")
  ownerSystem       OwnerSystem
  writeMode         WriteMode
  ownerDepartmentId String?
  ownerDepartment   Department? @relation(fields: [ownerDepartmentId], references: [id], onDelete: Restrict)
  requiresApproval  Boolean     @default(false)
  conflictPolicy    String      @default("owner_wins") // owner_wins | local_wins_once_edited | manual_review
  notes             String?
  createdAt         DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime    @updatedAt @db.Timestamptz(3)

  @@unique([entityType, fieldName])
}

// Record- and field-level permissions. A rule targets ONE subject: an AuthRole,
// a Position, a Department or a single Employee. AuthScope/AuthRole keep
// controlling which dashboard views open; these rules control which rows and
// fields inside them can be read or changed. Enforced on the backend only.
model DataPermissionRule {
  id           String           @id @default(uuid())
  roleKey      String?
  role         AuthRole?        @relation(fields: [roleKey], references: [key], onDelete: Cascade)
  positionId   String?
  position     Position?        @relation(fields: [positionId], references: [id], onDelete: Cascade)
  departmentId String?
  department   Department?      @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  employeeId   String?
  employee     Employee?        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  entityType   String
  fieldName    String           @default("*")
  action       PermissionAction
  scope        PermissionScope  @default(OWN)
  effect       PermissionEffect @default(ALLOW)
  conditions   Json? // extra predicates, e.g. {"maxAmount": 80000}
  priority     Int              @default(100) // DENY at equal priority wins
  active       Boolean          @default(true)
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @db.Timestamptz(3)

  @@index([entityType, action, active])
  @@index([roleKey])
  @@index([positionId])
  @@index([employeeId])
}

// Immutable business change history (UPDATE/DELETE revoked in SQL — see
// migrations/02_constraints.sql). The existing AuditLog stays as the WhatsApp
// pipeline's operational log.
model AuditEvent {
  id                String           @id @default(uuid())
  occurredAt        DateTime         @default(now()) @db.Timestamptz(3)
  actorType         ActorType
  actorEmployeeId   String?
  actorEmployee     Employee?        @relation(fields: [actorEmployeeId], references: [id], onDelete: Restrict)
  actorLabel        String? // automation slug / integration name when not an employee
  source            String // ui | api | automation | integration | workflow | migration
  entityType        String
  entityId          String
  operation         String // create | update | delete | merge | assign | approve | export | login
  changes           Json? // {"field": {"from": x, "to": y}}
  reason            String?
  approvalRequestId String?
  approvalRequest   ApprovalRequest? @relation(fields: [approvalRequestId], references: [id], onDelete: Restrict)
  correlationId     String? // ties together all events from one request / workflow
  ipAddress         String?
  userAgent         String?

  @@index([entityType, entityId, occurredAt])
  @@index([actorEmployeeId, occurredAt])
  @@index([occurredAt])
  @@index([correlationId])
}

// ── 5. Approvals ─────────────────────────────────────────────────────────────

// Stores the exact proposed change and the snapshot it was based on. Before
// executing, the executor re-reads the record; if baseVersion no longer
// matches, the request becomes STALE instead of applying an outdated change.
model ApprovalRequest {
  id                 String            @id @default(uuid())
  requestNo          Int               @unique @default(autoincrement()) // APR-000123
  type               ApprovalType
  status             ApprovalStatus    @default(PENDING)
  title              String
  reason             String?
  departmentId       String
  department         Department        @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  entityType         String
  entityId           String
  customerId         String?
  customer           Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  proposedChange     Json // exact field → new value set to apply
  baseSnapshot       Json? // record state when the request was raised
  baseVersion        String? // version / updatedAt / hash used for the staleness check
  amount             Decimal?          @db.Decimal(18, 2)
  requestedById      String
  requestedBy        Employee          @relation("ApprovalRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  currentStage       Int               @default(1)
  totalStages        Int               @default(1)
  currentApproverId  String?
  currentApprover    Employee?         @relation("ApprovalCurrentApprover", fields: [currentApproverId], references: [id], onDelete: Restrict)
  dueAt              DateTime?         @db.Timestamptz(3)
  decidedAt          DateTime?         @db.Timestamptz(3)
  executedAt         DateTime?         @db.Timestamptz(3)
  executionResult    Json?
  executionError     String?
  idempotencyKey     String?           @unique
  workflowInstanceId String?
  workflowInstance   WorkflowInstance? @relation(fields: [workflowInstanceId], references: [id], onDelete: SetNull)
  createdAt          DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @db.Timestamptz(3)

  events              ApprovalEvent[]
  auditEvents         AuditEvent[]
  integrationCommands IntegrationCommand[]
  workflowStep        WorkflowStep?

  @@index([status, currentApproverId])
  @@index([entityType, entityId])
  @@index([requestedById, createdAt])
  @@index([type, status])
}

model ApprovalEvent {
  id              String            @id @default(uuid())
  requestId       String
  request         ApprovalRequest   @relation(fields: [requestId], references: [id], onDelete: Restrict)
  stage           Int               @default(1)
  type            ApprovalEventType
  actorEmployeeId String?
  actorEmployee   Employee?         @relation(fields: [actorEmployeeId], references: [id], onDelete: Restrict)
  note            String?
  data            Json?
  occurredAt      DateTime          @default(now()) @db.Timestamptz(3)

  @@index([requestId, occurredAt])
}

// ── 6. Notifications ─────────────────────────────────────────────────────────

model Notification {
  id          String    @id @default(uuid())
  recipientId String
  recipient   Employee  @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  type        String // action_assigned | action_overdue | approval_needed | approval_decided | escalation | sync_failure ...
  title       String
  body        String?
  priority    Priority  @default(medium)
  entityType  String?
  entityId    String?
  link        String?
  dedupKey    String?   @unique // e.g. "overdue:<actionId>:<day>" — one reminder per action per day
  readAt      DateTime? @db.Timestamptz(3)
  archivedAt  DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  deliveries NotificationDelivery[]

  @@index([recipientId, readAt, createdAt])
}

model NotificationDelivery {
  id                String              @id @default(uuid())
  notificationId    String
  notification      Notification        @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  channel           NotificationChannel
  status            DeliveryStatus      @default(QUEUED)
  destination       String? // phone / email / device token
  providerMessageId String?
  attempts          Int                 @default(0)
  nextAttemptAt     DateTime?           @db.Timestamptz(3)
  lastError         String?
  sentAt            DateTime?           @db.Timestamptz(3)
  deliveredAt       DateTime?           @db.Timestamptz(3)
  createdAt         DateTime            @default(now()) @db.Timestamptz(3)

  @@unique([notificationId, channel])
  @@index([status, nextAttemptAt])
}

// ── 7. Business workflows ────────────────────────────────────────────────────
// Business-process orchestration. The existing Automation / AutomationRun stay
// for technical rule automations; a rule may START a WorkflowInstance.

model WorkflowDefinition {
  id           String      @id @default(uuid())
  key          String // discount_approval | overdue_collection | so_dispatch ...
  version      Int         @default(1)
  name         String
  description  String?
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  triggerType  String // manual | event | schedule
  triggerSpec  Json?
  definition   Json // ordered steps, approval stages, routing rules, SLAs
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime    @updatedAt @db.Timestamptz(3)

  instances WorkflowInstance[]

  @@unique([key, version])
}

model WorkflowInstance {
  id             String             @id @default(uuid())
  definitionId   String
  definition     WorkflowDefinition @relation(fields: [definitionId], references: [id], onDelete: Restrict)
  status         WorkflowStatus     @default(RUNNING)
  entityType     String?
  entityId       String?
  context        Json?
  currentStepKey String?
  startedById    String?
  startedBy      Employee?          @relation(fields: [startedById], references: [id], onDelete: SetNull)
  idempotencyKey String?            @unique
  correlationId  String?
  error          String?
  startedAt      DateTime           @default(now()) @db.Timestamptz(3)
  completedAt    DateTime?          @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @db.Timestamptz(3)

  steps     WorkflowStep[]
  actions   BusinessAction[]
  approvals ApprovalRequest[]

  @@index([status, updatedAt])
  @@index([entityType, entityId])
}

model WorkflowStep {
  id                   String              @id @default(uuid())
  instanceId           String
  instance             WorkflowInstance    @relation(fields: [instanceId], references: [id], onDelete: Restrict)
  stepKey              String
  sequence             Int
  type                 WorkflowStepType
  status               WorkflowStepStatus  @default(PENDING)
  input                Json?
  output               Json?
  error                String?
  attempts             Int                 @default(0)
  scheduledAt          DateTime?           @db.Timestamptz(3)
  startedAt            DateTime?           @db.Timestamptz(3)
  completedAt          DateTime?           @db.Timestamptz(3)
  actionId             String?             @unique
  action               BusinessAction?     @relation(fields: [actionId], references: [id], onDelete: SetNull)
  approvalRequestId    String?             @unique
  approvalRequest      ApprovalRequest?    @relation(fields: [approvalRequestId], references: [id], onDelete: SetNull)
  integrationCommandId String?             @unique
  integrationCommand   IntegrationCommand? @relation(fields: [integrationCommandId], references: [id], onDelete: SetNull)
  createdAt            DateTime            @default(now()) @db.Timestamptz(3)

  @@unique([instanceId, stepKey])
  @@index([status, scheduledAt])
}

// ── 8. Data quality ──────────────────────────────────────────────────────────

model DataQualityIssue {
  id           String          @id @default(uuid())
  ruleKey      String // duplicate_customer | missing_followup | orphan_so_item | unmapped_region | stale_sync ...
  fingerprint  String          @unique // ruleKey|entityType|entityId|field — re-detection updates, never duplicates
  severity     IssueSeverity   @default(MEDIUM)
  status       IssueStatus     @default(OPEN)
  entityType   String
  entityId     String
  fieldName    String?
  description  String
  details      Json?
  assigneeId   String?
  assignee     Employee?       @relation("IssueAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  actionId     String?
  action       BusinessAction? @relation(fields: [actionId], references: [id], onDelete: SetNull)
  detectedAt   DateTime        @default(now()) @db.Timestamptz(3)
  lastSeenAt   DateTime        @default(now()) @db.Timestamptz(3)
  resolvedAt   DateTime?       @db.Timestamptz(3)
  resolvedById String?
  resolvedBy   Employee?       @relation("IssueResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, severity])
  @@index([ruleKey, status])
  @@index([entityType, entityId])
}

// ── 9. Integration layer ─────────────────────────────────────────────────────

// Replaces plaintext Token rows over time: credentials live in a secret store
// (Workers secret / KMS-encrypted blob); this row holds only a reference.
model IntegrationConnection {
  id             String    @id @default(uuid())
  provider       String // zoho_books | neodove | waba | aisensy | n8n | google
  organizationId String    @default("") // Zoho org (BUI / DPG)
  label          String?
  secretRef      String // name/key of the secret in the secret store — never the secret itself
  scopes         String[]
  status         String    @default("active") // active | expired | revoked | error
  expiresAt      DateTime? @db.Timestamptz(3)
  lastHealthyAt  DateTime? @db.Timestamptz(3)
  lastError      String?
  metadata       Json?
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([provider, organizationId])
}

// Every inbound webhook, stored before processing.
model IntegrationEvent {
  id              String                 @id @default(uuid())
  provider        String
  organizationId  String                 @default("")
  eventType       String
  externalEventId String?
  idempotencyKey  String                 @unique
  payload         Json
  headers         Json?
  signatureValid  Boolean?
  status          IntegrationEventStatus @default(RECEIVED)
  attempts        Int                    @default(0)
  error           String?
  receivedAt      DateTime               @default(now()) @db.Timestamptz(3)
  processedAt     DateTime?              @db.Timestamptz(3)

  @@index([provider, status, receivedAt])
  @@index([eventType])
}

// Every outbound write to an external system. Nothing is assumed applied
// until status = SUCCEEDED with an externalRef/response from the provider.
model IntegrationCommand {
  id                String                   @id @default(uuid())
  provider          String
  organizationId    String                   @default("")
  commandType       String // zoho.estimate.update_status | neodove.lead.create | waba.message.send ...
  entityType        String?
  entityId          String?
  payload           Json
  idempotencyKey    String                   @unique
  status            IntegrationCommandStatus @default(QUEUED)
  attempts          Int                      @default(0)
  maxAttempts       Int                      @default(5)
  nextAttemptAt     DateTime?                @db.Timestamptz(3)
  lastError         String?
  response          Json?
  externalRef       String?
  requestedById     String?
  requestedBy       Employee?                @relation(fields: [requestedById], references: [id], onDelete: SetNull)
  approvalRequestId String?
  approvalRequest   ApprovalRequest?         @relation(fields: [approvalRequestId], references: [id], onDelete: Restrict)
  createdAt         DateTime                 @default(now()) @db.Timestamptz(3)
  sentAt            DateTime?                @db.Timestamptz(3)
  confirmedAt       DateTime?                @db.Timestamptz(3)
  updatedAt         DateTime                 @updatedAt @db.Timestamptz(3)

  workflowStep WorkflowStep?

  @@index([status, nextAttemptAt])
  @@index([provider, commandType])
  @@index([entityType, entityId])
}

// Sync checkpoints per provider/org/resource. Takes over the sync watermarks
// currently kept in Setting.
model IntegrationSyncState {
  id                String     @id @default(uuid())
  provider          String
  organizationId    String     @default("")
  resource          String // estimates | salesorders | invoices | contacts | calls ...
  cursor            String?
  status            SyncStatus @default(IDLE)
  lastAttemptAt     DateTime?  @db.Timestamptz(3)
  lastSuccessAt     DateTime?  @db.Timestamptz(3)
  lastError         String?
  consecutiveErrors Int        @default(0)
  recordsLastRun    Int        @default(0)
  staleAfterMinutes Int        @default(60)
  updatedAt         DateTime   @updatedAt @db.Timestamptz(3)

  @@unique([provider, organizationId, resource])
}

// ── 10. Data Explorer registry ───────────────────────────────────────────────
// Describes the real tables so the Explorer can search/filter/open them. It
// never copies their data.
model DataEntityDefinition {
  id           String      @id @default(uuid())
  key          String      @unique // customer | estimate | enquiry | sales_order | invoice | stock_item ...
  label        String
  modelName    String // Prisma model, e.g. CrmSalesOrder
  tableName    String
  primaryKey   String      @default("id")
  displayField String
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  searchFields Json // ["soNumber","customerName"]
  filters      Json // [{field, type, label}] — department/region/employee/status/date
  columns      Json
  relations    Json? // [{label, entityKey, foreignKey}] for "open linked record"
  detailRoute  String?
  ownerSystem  OwnerSystem @default(BUI)
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime    @updatedAt @db.Timestamptz(3)
}
