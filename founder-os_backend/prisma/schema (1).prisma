  @@index([day])
  @@index([numberHash])
  @@index([deviceId])
}

// ── Field Staff daily visits (Sales → Field Staff tab, migration 0117) ───────
// Mobile-web surface: check-in per location, GPS pings while open, mill rows
// (machine profile + requirement → auto Field-Staff enquiry), per-visit
// expenses + per-visit follow-ups. Raw D1 via modules/field-visits/store.ts.
model FieldVisit {
  id            String           @id @default(uuid())
  telecallerId  String
  day           String // YYYY-MM-DD IST
  city          String           @default("")
  address       String           @default("")
  lat           Float?
  lng           Float?
  note          String           @default("")
  checkInAt     DateTime
  lastPingAt    DateTime?
  checkOutAt    DateTime?
  createdBy     String           @default("")
  createdByName String           @default("")
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  millVisits    FieldMillVisit[]
  expenses      FieldExpense[]
  followups     FieldFollowup[]

  @@index([day])
  @@index([telecallerId])
  @@index([telecallerId, day])
}

model FieldMillVisit {
  id                String           @id @default(uuid())
  visitId           String
  visit             FieldVisit       @relation(fields: [visitId], references: [id], onDelete: Restrict)
  millName          String           @default("")
  keyContact        String           @default("")
  designation       String           @default("")
  phone             String           @default("")
  rollerPlantNos    String           @default("")
  attaChakkiNos     String           @default("")
  chakkiSize        String           @default("")
  runningTime       String           @default("")
  products          String           @default("")
  millAgeYrs        String           @default("")
  machineBrand      String           @default("")
  requirement       String           @default("")
  isNewSuggested    Boolean          @default(true)
  isNewManual       Boolean?
  matchMasterId     String           @default("")
  matchMasterName   String           @default("")
  enquiryId         String           @default("")
  followUpNeeded    Boolean          @default(false)
  createdBy         String           @default("")
  createdByName     String           @default("")
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  // ⟶ Customer master link (plan §4). Nullable until backfilled + reviewed.
  customerMasterId  String?
  customerMaster    Customer?        @relation(fields: [customerMasterId], references: [id], onDelete: Restrict)
  // ⟶ The mill as a PLANT address of the customer (machine profile lands in millProfile).
  customerAddressId String?
  customerAddress   CustomerAddress? @relation(fields: [customerAddressId], references: [id], onDelete: SetNull)

  @@index([visitId])
  @@index([customerMasterId])
}

model FieldExpense {
  id            String     @id @default(uuid())
  visitId       String
  visit         FieldVisit @relation(fields: [visitId], references: [id], onDelete: Restrict)
  amount        Float      @default(0)
  description   String     @default("")
  createdBy     String     @default("")
  createdByName String     @default("")
  createdAt     DateTime   @default(now())

  @@index([visitId])
}

model FieldFollowup {
  id            String     @id @default(uuid())
  visitId       String
  visit         FieldVisit @relation(fields: [visitId], references: [id], onDelete: Restrict)
  millVisitId   String     @default("")
  dueDate       String     @default("")
  note          String     @default("")
  owner         String     @default("")
  status        String     @default("open")
  createdBy     String     @default("")
  createdByName String     @default("")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([visitId])
  @@index([status])
}

// -- Stock (manual inventory: auto-SKU catalogue + dated movements) --
// Closing stock is derived (sum of movements <= day), never stored. SKU is
// system-generated (CAT-0007), never typed. Multi-location with transfer;
// available = on-hand minus reserved (open SO reservations).
model StockItem {
  id                  String             @id @default(uuid())
  sku                 String             @unique
  productName         String
  category            String             @default("")
  brand               String             @default("")
  barcode             String             @default("")
  unit                String             @default("pcs")
  unitPurchase        String             @default("")
  unitFactor          Float              @default(1)
  purchaseRate        Float              @default(0)
  saleRate            Float              @default(0)
  supplier            String             @default("")
  reorderLevel        Float              @default(0)
  minLevel            Float              @default(0)
  maxLevel            Float              @default(0)
  avgDailyConsumption Float              @default(0)
  leadTimeDays        Float              @default(0)
  safetyFactor        Float              @default(0)
  moq                 Float              @default(0)
  imageUrl            String             @default("")
  active              Boolean            @default(true)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  movements           StockMovement[]
  reservations        StockReservation[]
  // ⟶ Product identity: SKU → KYP catalogue product; supplier string → Vendor.
  productId           String?
  product             ProductItem?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  preferredVendorId   String?
  preferredVendor     Vendor?            @relation(fields: [preferredVendorId], references: [id], onDelete: SetNull)
  soItems             CrmSoItem[]

  @@index([active, sku])
  @@index([productId])
  @@index([category, active])
}

model StockLocation {
  id           String             @id @default(uuid())
  name         String             @unique
  active       Boolean            @default(true)
  createdAt    DateTime           @default(now())
  movementsOut StockMovement[]    @relation("MovementFrom")
  movementsIn  StockMovement[]    @relation("MovementTo")
  reservations StockReservation[]
}

model StockMovement {
  id           String         @id @default(uuid())
  itemId       String
  // Was Cascade. The stock ledger is history: an item with movements cannot be deleted (deactivate it).
  item         StockItem      @relation(fields: [itemId], references: [id], onDelete: Restrict)
  day          String
  kind         String
  qty          Float
  // Were String @default(""). Blanks normalised to NULL before the FKs are added.
  locationId   String?
  location     StockLocation? @relation("MovementFrom", fields: [locationId], references: [id], onDelete: Restrict)
  toLocationId String?
  toLocation   StockLocation? @relation("MovementTo", fields: [toLocationId], references: [id], onDelete: Restrict)
  rate         Float          @default(0)
  status       String         @default("approved")
  refType      String         @default("")
  refId        String         @default("")
  note         String         @default("")
  createdBy    String         @default("")
  createdAt    DateTime       @default(now())

  @@index([itemId, day])
  @@index([day, kind])
  @@index([locationId, day])
  @@index([toLocationId])
}

model StockReservation {
  id         String         @id @default(uuid())
  itemId     String
  // Was Cascade. Reservation history is preserved.
  item       StockItem      @relation(fields: [itemId], references: [id], onDelete: Restrict)
  locationId String?
  location   StockLocation? @relation(fields: [locationId], references: [id], onDelete: Restrict)
  qty        Float
  refType    String         @default("SO")
  refId      String         @default("")
  status     String         @default("open")
  day        String         @default("")
  createdBy  String         @default("")
  createdAt  DateTime       @default(now())

  @@index([itemId, status])
  @@index([refId, status])
  @@index([locationId])
}

// ═════════════════════════════════════════════════════════════════════════════
// ═══  BUI FOUNDER OS — CONTROL PLANE (added by the consolidation plan)      ═══
// ═════════════════════════════════════════════════════════════════════════════
// Conventions for everything below this line:
//   • Timestamps are UTC (timestamptz). Render in Asia/Kolkata in the UI.
//   • Calendar-only dates use @db.Date (no more "YYYY-MM-DD" strings).
//   • Money is Decimal(18,2). Structured payloads are Json (jsonb).
//   • History tables use validFrom/validTo: the open row (validTo = null) is
//     the current state; closing a row + opening a new one preserves history.
//   • "Exactly one open row" rules (e.g. one primary department) are enforced
//     with partial unique indexes in SQL — Prisma cannot express them. See
//     migrations/02_constraints.sql.

