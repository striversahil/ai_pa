    "custom": {
      "label": "Custom Webhook / REST API",
      "category": "custom",
      "direction": "bidirectional",
      "multiInstance": true,
      "description": "Universal connector for any webhook or REST API in the world without code changes.",
      "auth": {
        "strategy": "custom_http",
        "configFields": [
          {
            "key": "baseUrl",
            "label": "Outbound Base URL",
            "type": "text",
            "required": false
          },
          {
            "key": "authScheme",
            "label": "Outbound Auth Scheme",
            "type": "select",
            "options": [
              "none",
              "bearer",
              "custom_header",
              "basic",
              "query_param"
            ],
            "default": "bearer",
            "required": true
          },
          {
            "key": "authHeaderName",
            "label": "Auth Header / Query Key Name",
            "type": "text",
            "default": "Authorization",
            "required": false
          },
          {
            "key": "signatureHeaderName",
            "label": "Inbound HMAC Header Name",
            "type": "text",
            "required": false
          },
          {
            "key": "idempotencyPath",
            "label": "Inbound Dedupe JSON Path",
            "type": "text",
            "default": "event_id",
            "required": false
          },
          {
            "key": "targetSink",
            "label": "Inbound CRM Target",
            "type": "select",
            "options": [
              "core_lead",
              "estimates",
              "raw_store_only"
            ],
            "default": "raw_store_only",
            "required": true
          },
          {
            "key": "fieldMapJson",
            "label": "JSON Field Mapping Override",
            "type": "json",
            "default": "{\"externalId\":\"id\",\"contactName\":\"name\",\"phone\":\"phone\",\"rawNotes\":\"notes\"}",
            "required": false
          }
        ],
        "secretFields": [
          {
            "key": "authToken",
            "label": "Outbound API Key / Bearer Token",
            "required": false
          },
          {
            "key": "webhookSecret",
            "label": "Inbound HMAC Signing Secret",
            "required": false
          }
        ]
      },
      "outbound": {
        "supported": true,
        "adapter": "custom-http",
        "capabilities": [
          "http.request",
          "http.get",
          "http.post"
        ]
      },
      "inbound": {
        "supported": true,
        "transport": "webhook_get_or_post",
        "normalizeQueryToBodyOnGet": true,
        "defaultDeliveryMode": "batch",
        "allowedDeliveryModes": [
          "realtime",
          "batch"
        ],
        "verification": {
          "signaturePost": {
            "algorithm": "hmac-sha256",
            "headerNameFromConfig": "signatureHeaderName",
            "secretKey": "webhookSecret",
            "optionalIfSecretUnset": true
          }
        },
        "idempotencyKey": {
          "strategy": "config_path",
          "configKey": "idempotencyPath",
          "fallbackPaths": [
            "event_id",
            "id",
            "uuid"
          ]
        },
        "mapper": "custom",
        "canonicalType": "CanonicalDynamic",
        "targetSinkFromConfig": "targetSink",
        "liveEvent": "data-changed"
      }
    }
  }
