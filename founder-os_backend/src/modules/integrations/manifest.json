            "historyId"
          ]
        },
        "mapper": "email",
        "canonicalType": "CanonicalEmail",
        "targetSink": "brain_and_leads",
        "liveEvent": "data-changed",
        "poller": {
          "intervalMinutes": 5,
          "cursorField": "lastPollAt"
        }
      }
    },
