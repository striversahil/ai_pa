        {
          "key": "baseUrlOverride",
          "label": "Base URL override",
          "type": "text",
          "placeholder": "https://www.googleapis.com/customsearch/v1"
        }
      ],
      "secretFields": [
        {
          "key": "apiKey",
          "label": "API key",
          "type": "text",
          "required": true
        }
      ],
      "outbound": {
        "supported": true,
        "operations": [
          "search"
        ]
      },
      "inbound": {
        "supported": false
      }
    },
    "custom": {
      "label": "Custom HTTP",
      "category": "custom",
      "direction": "both",
      "multiInstance": true,
      "instanceRequired": true,
      "description": "Any REST endpoint. bearer | custom_header | basic | query_param | none auth.",
      "configFields": [
        {
          "key": "baseUrl",
          "label": "Base URL",
          "type": "text",
          "required": true,
          "placeholder": "https://erp.example.com"
        },
        {
          "key": "authScheme",
          "label": "Auth scheme",
          "type": "select",
          "options": [
            "bearer",
            "custom_header",
            "basic",
            "query_param",
            "none"
          ],
          "defaultValue": "bearer"
        },
        {
          "key": "authHeaderName",
          "label": "Auth header name",
          "type": "text",
          "placeholder": "Authorization"
        },
        {
          "key": "authQueryParam",
          "label": "Auth query param",
          "type": "text",
          "placeholder": "api_key"
        },
        {
          "key": "fieldMapJson",
          "label": "Field map (JSON)",
          "type": "json"
        },
        {
          "key": "idempotencyField",
          "label": "Idempotency field",
          "type": "text"
        }
      ],
      "secretFields": [
        {
          "key": "authToken",
          "label": "Auth token",
          "type": "text"
        },
        {
          "key": "webhookSecret",
          "label": "Webhook secret",
          "type": "text"
        }
      ],
      "outbound": {
        "supported": true,
        "operations": [
          "request",
          "get",
          "post",
          "ping"
        ]
      },
      "inbound": {
        "supported": true,
        "methods": [
          "GET",
          "POST"
        ],
        "defaultDeliveryMode": "batch",
        "liveEvent": "enquiries",
        "normalizeQueryToBodyOnGet": true,
        "verification": {
          "kind": "hmac",
          "header": "x-ingest-signature",
          "algorithm": "sha256",
          "secretField": "webhookSecret"
        },
        "idempotencyKey": {
          "mode": "config_path",
          "configField": "idempotencyField"
        },
        "fieldMap": {}
      }
    },
