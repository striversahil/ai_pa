    "gmail": {
      "label": "Gmail / Google Workspace Mail",
      "category": "email",
      "direction": "bidirectional",
      "multiInstance": true,
      "description": "Reads buyer RFQ emails for Brain indexing/lead extraction and sends quote follow-ups via Gmail API v1.",
      "auth": {
        "strategy": "oauth2",
        "tokenCachePrefix": "gmail",
        "defaultBaseUrl": "https://gmail.googleapis.com/gmail/v1",
        "accountsUrl": "https://oauth2.googleapis.com/token",
        "configFields": [
          {
            "key": "mailboxEmail",
            "label": "Connected Mailbox Email",
            "type": "text",
            "required": true
          },
          {
            "key": "labelFilter",
            "label": "Sync Label / Query (e.g. is:unread)",
            "type": "text",
            "default": "in:inbox",
            "required": false
          }
        ],
        "secretFields": [
          {
            "key": "clientId",
            "label": "Google OAuth Client ID",
            "required": true
          },
          {
            "key": "clientSecret",
            "label": "Google OAuth Client Secret",
            "required": true
          },
          {
            "key": "refreshToken",
            "label": "Google OAuth Refresh Token",
            "required": true
          }
        ]
      },
      "outbound": {
        "supported": true,
        "adapter": "gmail",
        "capabilities": [
          "messages.list",
          "messages.get",
          "messages.send",
          "drafts.create"
        ],
        "retryPolicy": {
          "retryOnStatus": [
