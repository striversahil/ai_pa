    "telegram": {
      "label": "Telegram Bot API",
      "category": "social",
      "direction": "bidirectional",
      "multiInstance": true,
      "description": "Instant internal dispatch alerts, approvals, and buyer enquiries via Telegram Bot.",
      "auth": {
        "strategy": "bot_token_path",
        "defaultBaseUrl": "https://api.telegram.org",
        "configFields": [
          {
            "key": "defaultChatId",
            "label": "Default Group / Channel Chat ID",
            "type": "text",
            "required": false
          }
        ],
