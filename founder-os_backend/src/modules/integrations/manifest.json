{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "version": "2.0.0",
  "description": "Master manifest for Founder OS outbound call(provider, opts) adapters, inbound hlp_ingested_data ingestion rules, dual-mode (realtime/batch) routing, and dynamic Settings UI.",
  "defaults": {
    "webhookRoutePattern": "/api/webhooks/{provider}/{instanceKey}",
    "defaultInstanceKey": "default",
    "maxRetriesBeforeDeadLetter": 3,
    "batchClaimSize": 50
  },
  "providers": {
    "openai": {
      "label": "OpenAI-Compatible AI Provider",
      "category": "ai",
      "direction": "outbound",
      "multiInstance": true,
      "description": "Configure multiple OpenAI-compatible providers (OpenAI, Groq, OpenRouter, DeepSeek, Together, Fireworks, Ollama) with separate base URLs, API keys, and models.",
      "auth": {
        "strategy": "openai_compatible_multi_instance",
        "fallbackPoolSetting": "ai:providers",
        "defaultBaseUrl": "https://api.openai.com/v1",
        "configFields": [
          {
            "key": "providerVendor",
            "label": "Vendor Preset",
            "type": "select",
            "options": [
              "openai",
              "groq",
              "openrouter",
              "deepseek",
              "together",
              "fireworks",
              "ollama",
              "custom_openai"
            ],
            "default": "openai",
            "required": true
          },
          {
            "key": "baseUrl",
            "label": "OpenAI-Compatible Base URL",
            "type": "text",
            "placeholder": "https://api.groq.com/openai/v1",
            "required": true
          },
          {
            "key": "model",
            "label": "Default Model ID",
            "type": "text",
            "placeholder": "gpt-4o-mini / llama-3.3-70b-versatile / deepseek-chat",
            "required": true
          },
          {
            "key": "fallbackToGlobalPool",
            "label": "Failover to Global ai:providers Pool on Error",
            "type": "boolean",
            "default": true,
            "required": false
          }
        ],
        "secretFields": [
          {
            "key": "apiKeys",
            "label": "API Key(s) (comma-separated for automatic rotation)",
            "required": true
          }
        ]
      },
      "outbound": {
        "supported": true,
        "adapter": "openai",
        "capabilities": [
          "chat.complete",
          "chat.completeJson",
          "chat.completeJsonStream",
          "embeddings.create"
        ],
        "headersInjected": {
          "Authorization": "Bearer {{activeApiKey}}",
          "Content-Type": "application/json"
        }
      },
      "inbound": {
        "supported": false
      }
    },
    "zoho": {
      "label": "Zoho Books",
      "category": "accounting",
      "direction": "bidirectional",
      "multiInstance": true,
      "description": "Syncs sent estimates, sales orders, customer statements, and comments.",
      "auth": {
        "strategy": "oauth2_or_raw_headers",
        "tokenCachePrefix": "zoho",
        "defaultBaseUrl": "https://www.zohoapis.in/books/v3",
        "accountsUrl": "https://accounts.zoho.in/oauth/v2/token",
        "configFields": [
          {
            "key": "authMode",
            "label": "Auth Mode",
            "type": "select",
            "options": [
              "oauth2",
              "raw_headers_bridge"
            ],
            "default": "oauth2",
            "required": true
          },
          {
            "key": "organizationId",
            "label": "Organization ID",
            "type": "text",
            "required": true
          },
          {
            "key": "apiDomain",
            "label": "API Domain",
            "type": "text",
            "default": "https://www.zohoapis.in/books/v3",
            "required": false
          }
        ],
        "secretFields": [
          {
            "key": "clientId",
            "label": "OAuth Client ID",
            "requiredWhen": {
              "authMode": "oauth2"
            }
          },
          {
            "key": "clientSecret",
            "label": "OAuth Client Secret",
            "requiredWhen": {
              "authMode": "oauth2"
            }
          },
          {
            "key": "refreshToken",
            "label": "OAuth Refresh Token",
            "requiredWhen": {
              "authMode": "oauth2"
            }
          },
          {
            "key": "rawCurlHeaders",
            "label": "Legacy cURL Headers JSON (Bridge)",
            "requiredWhen": {
              "authMode": "raw_headers_bridge"
            }
          }
        ]
      },
      "outbound": {
        "supported": true,
        "adapter": "zoho",
        "capabilities": [
          "estimates.list",
          "estimates.get",
          "estimates.comments",
          "salesorders.list",
          "salesorders.get",
          "contacts.statement"
        ],
        "headersInjected": {
          "Authorization": "Zoho-oauthtoken {{accessToken}}",
          "X-com-zoho-books-organizationid": "{{config.organizationId}}"
        },
        "retryPolicy": {
          "retryOnStatus": [
            401,
            429,
            500,
            502,
            503
          ],
          "refreshTokenOn401": true
        }
      },
      "inbound": {
        "supported": true,
        "transport": "webhook_post",
        "defaultDeliveryMode": "batch",
        "allowedDeliveryModes": [
          "realtime",
          "batch"
        ],
        "verification": {
          "type": "optional_header_token",
          "headerName": "X-Zoho-Webhook-Token",
          "secretKey": "webhookToken"
        },
        "idempotencyKey": {
          "strategy": "composite",
          "paths": [
            "estimate.estimate_id",
            "estimate.last_modified_time"
          ],
          "fallbackPaths": [
            "salesorder.salesorder_id",
            "salesorder.last_modified_time"
          ]
        },
        "mapper": "zoho-estimate",
        "canonicalType": "CanonicalEstimate",
        "targetSink": "estimates",
        "liveEvent": "estimates",
        "quietHoursIst": {
          "enabled": true,
          "pauseStart": "21:00",
          "pauseEnd": "09:00"
        }
      }
    },
    "indiamart": {
      "label": "IndiaMART Lead Manager",
      "category": "b2b_portal",
      "direction": "inbound",
      "multiInstance": true,
      "description": "Ingests buyer enquiries via IndiaMART CRM Push Webhook or Pull API v2.",
      "auth": {
        "strategy": "api_key",
        "defaultBaseUrl": "https://mapi.indiamart.com/wservce/crm/crmListing/v2/",
        "configFields": [],
        "secretFields": []
      },
      "outbound": {
        "supported": false
      },
      "inbound": {
        "supported": true,
        "transport": "webhook_post",
        "defaultDeliveryMode": "realtime",
        "allowedDeliveryModes": [
          "realtime",
          "batch"
        ],
        "idempotencyKey": {
          "strategy": "path",
          "paths": [
            "RESPONSE.UNIQUE_QUERY_ID",
            "UNIQUE_QUERY_ID"
          ]
        },
        "mapper": "b2b-portals",
        "canonicalType": "CanonicalLead",
        "fieldMap": {
          "externalId": "RESPONSE.UNIQUE_QUERY_ID",
          "contactName": "RESPONSE.SENDER_NAME",
          "companyName": "RESPONSE.SENDER_COMPANY",
          "phone": "RESPONSE.SENDER_MOBILE",
          "email": "RESPONSE.SENDER_EMAIL",
          "city": "RESPONSE.SENDER_CITY",
          "productInterest": "RESPONSE.QUERY_PRODUCT_NAME",
          "rawNotes": "RESPONSE.QUERY_MESSAGE",
          "receivedAt": "RESPONSE.QUERY_TIME"
        },
        "targetSink": "core_lead",
        "liveEvent": "enquiries"
      }
    },
    "tradeindia": {
      "label": "TradeIndia B2B Portal",
      "category": "b2b_portal",
      "direction": "inbound",
      "multiInstance": true,
      "description": "Receives TradeIndia buyer RFQs through the signed inbound webhook and stages them in hlp_ingested_data.",
      "auth": {
        "strategy": "query_credentials",
        "defaultBaseUrl": "https://www.tradeindia.com/utils/my_inquiry.html",
        "configFields": [
          {
            "key": "userId",
            "label": "TradeIndia User ID",
            "type": "text",
            "required": true
          },
          {
            "key": "profileId",
            "label": "TradeIndia Profile ID",
            "type": "text",
            "required": true
          }
        ],
        "secretFields": [
          {
            "key": "apiKey",
            "label": "TradeIndia API Key",
            "required": true
          }
        ]
      },
      "outbound": {
        "supported": true,
        "adapter": "custom-http"
      },
      "inbound": {
        "supported": true,
        "transport": "webhook_post",
        "defaultDeliveryMode": "batch",
        "allowedDeliveryModes": [
          "realtime",
          "batch"
        ],
        "idempotencyKey": {
          "strategy": "path",
          "paths": [
            "rfi_id",
            "inquiry_id"
          ]
        },
        "mapper": "b2b-portals",
        "canonicalType": "CanonicalLead",
        "fieldMap": {
          "externalId": "rfi_id",
          "contactName": "sender_name",
          "companyName": "sender_co",
          "phone": "sender_mobile",
          "email": "sender_email",
          "city": "sender_city",
          "productInterest": "product_name",
          "quantity": "quantity",
          "rawNotes": "message",
          "receivedAt": "generated_date"
        },
        "targetSink": "core_lead",
        "liveEvent": "enquiries",
        "quietHoursIst": {
          "enabled": true,
          "pauseStart": "21:00",
          "pauseEnd": "09:00"
        }
      }
    },
    "justdial": {
      "label": "Justdial B2B Leads",
      "category": "b2b_portal",
      "direction": "inbound",
      "multiInstance": true,
      "description": "Captures real-time Justdial leads pushed via HTTP GET query parameters or POST.",
      "auth": {
        "strategy": "payload_guard",
        "configFields": [
          {
            "key": "expectedParentId",
            "label": "Justdial Parent ID (Spoof Guard)",
            "type": "text",
            "required": false
          }
        ],
        "secretFields": []
      },
      "outbound": {
        "supported": false
      },
      "inbound": {
        "supported": true,
        "transport": "webhook_get_or_post",
        "normalizeQueryToBodyOnGet": true,
        "defaultDeliveryMode": "realtime",
        "allowedDeliveryModes": [
          "realtime",
          "batch"
        ],
        "verification": {
          "type": "field_match",
          "payloadPath": "parentid",
          "configKey": "expectedParentId",
          "optionalIfConfigUnset": true
        },
        "idempotencyKey": {
          "strategy": "path",
          "paths": [
            "leadid"
          ]
        },
        "mapper": "b2b-portals",
        "canonicalType": "CanonicalLead",
        "fieldMap": {
          "externalId": "leadid",
          "contactName": "name",
          "companyName": "company",
          "phone": "mobile",
          "email": "email",
          "city": "city",
          "productInterest": "category",
          "rawNotes": "remarks",
          "receivedAt": "date"
        },
        "targetSink": "core_lead",
        "liveEvent": "enquiries"
      }
    },
    "exportersindia": {
      "label": "ExportersIndia B2B Portal",
      "category": "b2b_portal",
      "direction": "inbound",
      "multiInstance": true,
      "description": "Pulls or receives pushed buyer enquiries from ExportersIndia Inquiry API.",
      "auth": {
        "strategy": "api_key",
        "defaultBaseUrl": "https://www.exportersindia.com/api/inquiry.php",
        "configFields": [
          {
            "key": "registeredEmail",
            "label": "Registered Member Email",
            "type": "text",
            "required": true
          }
        ],
        "secretFields": [
          {
            "key": "apiKey",
            "label": "ExportersIndia Inquiry API Key",
            "required": true
          }
        ]
      },
      "outbound": {
        "supported": true,
        "adapter": "custom-http"
      },
      "inbound": {
        "supported": true,
        "transport": "webhook_post",
        "defaultDeliveryMode": "batch",
        "allowedDeliveryModes": [
          "realtime",
          "batch"
        ],
        "idempotencyKey": {
          "strategy": "path",
          "paths": [
            "inquiry_id",
            "id"
          ]
        },
        "mapper": "b2b-portals",
        "canonicalType": "CanonicalLead",
        "fieldMap": {
          "externalId": "inquiry_id",
          "contactName": "name",
          "companyName": "company",
          "phone": "mobile",
          "email": "email",
          "city": "city",
          "productInterest": "subject",
          "rawNotes": "message"
        },
        "targetSink": "core_lead",
        "liveEvent": "enquiries"
      }
    },
    "alibaba": {
      "label": "Alibaba.com Seller / RFQ",
      "category": "b2b_portal",
      "direction": "inbound",
      "multiInstance": true,
      "description": "Ingests export buyer RFQs and TradeManager messages from Alibaba.com.",
      "auth": {
        "strategy": "oauth2",
        "tokenCachePrefix": "alibaba",
        "defaultBaseUrl": "https://openapi.alibaba.com/api",
        "configFields": [
          {
            "key": "sellerMemberId",
            "label": "Alibaba Member ID",
            "type": "text",
            "required": true
          }
        ],
        "secretFields": [
          {
            "key": "appKey",
            "label": "App Key",
            "required": true
          },
          {
            "key": "appSecret",
            "label": "App Secret",
            "required": true
          },
          {
            "key": "accessToken",
            "label": "Access Token",
            "required": true
          }
        ]
      },
      "outbound": {
        "supported": true,
        "adapter": "custom-http",
        "capabilities": [
          "rfq.list",
          "inquiries.list"
        ]
      },
      "inbound": {
        "supported": true,
        "transport": "webhook_post",
        "defaultDeliveryMode": "batch",
        "allowedDeliveryModes": [
          "realtime",
          "batch"
        ],
        "idempotencyKey": {
          "strategy": "path",
          "paths": [
            "inquiry_id",
            "rfq_id",
            "message_id"
          ]
        },
        "mapper": "b2b-portals",
        "canonicalType": "CanonicalLead",
        "fieldMap": {
          "externalId": "inquiry_id",
          "contactName": "buyer_name",
          "companyName": "buyer_company",
          "phone": "buyer_phone",
          "email": "buyer_email",
          "city": "buyer_country",
          "productInterest": "product_title",
          "quantity": "quantity",
          "rawNotes": "content"
        },
        "targetSink": "core_lead",
        "liveEvent": "enquiries"
      }
    },
    "whatsapp": {
      "label": "Meta WhatsApp Cloud API",
      "category": "social",
      "direction": "bidirectional",
      "multiInstance": true,
      "description": "Real-time WhatsApp customer chats, template dispatches, and lead capture via Graph API v27.0.",
      "auth": {
        "strategy": "bearer_token",
        "defaultBaseUrl": "https://graph.facebook.com/v27.0",
        "configFields": [
          {
            "key": "phoneNumberId",
            "label": "Phone Number ID",
            "type": "text",
            "required": true
          },
          {
            "key": "wabaId",
            "label": "WhatsApp Business Account ID",
            "type": "text",
            "required": true
          },
          {
            "key": "verifyToken",
            "label": "Webhook Verify Token",
            "type": "text",
            "required": true
          }
        ],
        "secretFields": [
          {
            "key": "accessToken",
            "label": "Permanent System User Access Token",
            "required": true
          },
          {
            "key": "appSecret",
            "label": "Meta App Secret",
            "required": true
          }
        ]
      },
      "outbound": {
        "supported": true,
        "adapter": "whatsapp",
        "capabilities": [
          "messages.sendText",
          "messages.sendTemplate",
          "messages.sendMedia"
        ],
        "headersInjected": {
          "Authorization": "Bearer {{secrets.accessToken}}",
          "Content-Type": "application/json"
        }
      },
      "inbound": {
        "supported": true,
        "transport": "webhook_get_and_post",
        "defaultDeliveryMode": "realtime",
        "allowedDeliveryModes": [
          "realtime",
          "batch"
        ],
        "verification": {
          "challengeGet": {
            "modeParam": "hub.mode",
            "expectedMode": "subscribe",
            "tokenParam": "hub.verify_token",
            "challengeParam": "hub.challenge"
          },
          "signaturePost": {
            "algorithm": "hmac-sha256",
            "headerName": "X-Hub-Signature-256",
            "prefix": "sha256=",
            "encoding": "hex",
            "secretKey": "appSecret"
          }
        },
        "idempotencyKey": {
          "strategy": "path",
          "paths": [
            "entry[0].changes[0].value.messages[0].id",
            "entry[0].changes[0].value.statuses[0].id"
          ]
        },
        "mapper": "social-meta",
        "canonicalType": "CanonicalMessage",
        "targetSink": "whatsapp_messages",
        "liveEvent": "messages"
      }
    },
