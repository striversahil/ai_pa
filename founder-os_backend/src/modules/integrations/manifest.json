{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "version": "2.0.0",
  "description": "Founder OS integration manifest: outbound adapters, inbound webhook/poller rules, dual-mode routing and Settings UI.",
  "defaults": {
    "webhookRoutePattern": "/api/webhooks/{provider}/{instanceKey}",
    "defaultInstanceKey": "default",
    "maxRetriesBeforeDeadLetter": 3,
    "batchClaimSize": 50,
    "quietHoursIst": [
      21,
      9
    ]
  },
  "categories": {
    "ai": "AI",
    "accounting": "Accounting",
    "b2b_portal": "B2B portals",
    "social": "Social & messaging",
    "forms": "Forms",
    "email": "Email",
    "geo_enrichment": "Geo enrichment",
    "search_enrichment": "Search enrichment",
    "telecalling": "Telecalling",
    "custom": "Custom"
  },
  "providers": {
    "openai": {
      "label": "OpenAI-compatible AI",
      "category": "ai",
      "direction": "outbound",
      "multiInstance": true,
      "instanceRequired": false,
      "description": "Multi-instance, multi-vendor key rotation with fallback to the global Setting ai:providers pool.",
      "configFields": [
        {
          "key": "baseUrl",
          "label": "Base URL",
          "type": "text",
          "placeholder": "https://api.openai.com/v1"
        },
        {
          "key": "model",
          "label": "Model",
          "type": "text",
          "placeholder": "gpt-4o-mini"
        },
        {
          "key": "fallbackToGlobalPool",
          "label": "Fall back to global pool",
          "type": "boolean",
          "defaultValue": true
        }
      ],
      "secretFields": [
        {
          "key": "apiKeys",
          "label": "API keys (comma separated)",
          "type": "textarea",
          "hint": "Rotated in order."
        }
      ],
      "outbound": {
        "supported": true,
        "defaultDeliveryMode": "realtime",
        "operations": [
          "complete",
          "completeJson",
          "completeJsonStream",
          "embed"
        ]
      },
      "inbound": {
        "supported": false
      }
    },
    "zoho": {
      "label": "Zoho Books",
      "category": "accounting",
      "direction": "both",
      "multiInstance": true,
      "instanceRequired": true,
      "description": "OAuth2 refresh (cached as zoho:<instanceKey>) or a raw curl-headers bridge for the legacy sent_estimates token.",
      "configFields": [
        {
          "key": "authMode",
          "label": "Auth mode",
          "type": "select",
          "options": [
            "oauth2",
            "raw_headers_bridge"
          ],
          "required": true,
          "defaultValue": "oauth2"
        },
        {
          "key": "organizationId",
          "label": "Organization ID",
          "type": "text",
          "requiredWhen": {
            "field": "authMode",
            "equals": "oauth2"
          }
        },
        {
          "key": "accountsUrl",
          "label": "Accounts URL",
          "type": "text",
          "placeholder": "https://accounts.zoho.in"
        },
        {
          "key": "apiDomain",
          "label": "API domain",
          "type": "text",
          "placeholder": "https://www.zohoapis.in"
        }
      ],
      "secretFields": [
        {
          "key": "clientId",
          "label": "Client ID",
          "type": "text",
          "requiredWhen": {
            "field": "authMode",
            "equals": "oauth2"
          }
        },
        {
          "key": "clientSecret",
          "label": "Client secret",
          "type": "text",
          "requiredWhen": {
            "field": "authMode",
            "equals": "oauth2"
          }
        },
        {
          "key": "refreshToken",
          "label": "Refresh token",
          "type": "text",
          "requiredWhen": {
            "field": "authMode",
            "equals": "oauth2"
          }
        },
        {
          "key": "rawCurlHeaders",
          "label": "Raw curl headers",
          "type": "textarea",
          "requiredWhen": {
            "field": "authMode",
            "equals": "raw_headers_bridge"
          },
          "hint": "Paste the -H lines from sent_estimates.txt."
        },
        {
          "key": "webhookSecret",
          "label": "Webhook token",
          "type": "text"
        }
      ],
      "outbound": {
        "supported": true,
        "operations": [
          "request",
          "getSentEstimates",
          "getEstimate",
          "getComments",
          "ping"
        ]
      },
      "inbound": {
        "supported": true,
        "methods": [
          "POST"
        ],
        "defaultDeliveryMode": "batch",
        "liveEvent": "enquiries",
        "verification": {
          "kind": "optional_header_token",
          "header": "X-Zoho-Webhook-Token",
          "secretField": "webhookSecret"
        },
        "idempotencyKey": {
          "mode": "composite",
          "parts": [
            "estimate_id",
            "last_modified_time"
          ],
          "prefixes": [
            "estimate.",
            "payload."
          ]
        },
        "fieldMap": {
          "externalId": "estimate_id",
          "estimateNumber": "estimate_number",
          "customerName": "customer_name",
          "phone": "billing_address.phone",
          "email": "billing_address.email",
          "amount": "total"
        }
      }
    },
    "whatsapp": {
      "label": "WhatsApp Cloud",
      "category": "social",
      "direction": "both",
      "multiInstance": true,
      "instanceRequired": true,
      "description": "Meta Cloud API messages + statuses. Verification handshake and X-Hub-Signature-256.",
      "configFields": [
        {
          "key": "phoneNumberId",
          "label": "Phone number ID",
          "type": "text",
          "required": true
        },
        {
          "key": "apiVersion",
          "label": "Graph version",
          "type": "text",
          "defaultValue": "v21.0"
        },
        {
          "key": "businessId",
          "label": "Business account ID",
          "type": "text"
        },
        {
          "key": "verifyToken",
          "label": "Webhook verify token",
          "type": "text",
          "required": true
        }
      ],
      "secretFields": [
        {
          "key": "accessToken",
          "label": "Access token",
          "type": "text",
          "required": true
        },
        {
          "key": "appSecret",
          "label": "App secret",
          "type": "text",
          "required": true
        }
      ],
      "outbound": {
        "supported": true,
        "operations": [
          "sendText",
          "sendTemplate",
          "ping"
        ]
      },
      "inbound": {
        "supported": true,
        "methods": [
          "GET",
          "POST"
        ],
        "defaultDeliveryMode": "realtime",
        "liveEvent": "enquiries",
        "challengeGet": true,
        "verification": {
          "kind": "hmac",
          "header": "x-hub-signature-256",
          "algorithm": "sha256",
          "secretField": "appSecret"
        },
        "idempotencyKey": {
          "mode": "path",
          "path": "messages.0.id"
        },
        "fieldMap": {
          "phone": "contacts.0.wa_id",
          "text": "messages.0.text.body",
          "messageId": "messages.0.id",
          "mediaId": "messages.0.image.id"
        }
      }
    },
    "gmail": {
      "label": "Gmail",
      "category": "email",
      "direction": "both",
      "multiInstance": true,
      "instanceRequired": true,
      "description": "Google OAuth2 mailbox reader/sender. Tokens cached as gmail:<instanceKey>.",
      "configFields": [
        {
          "key": "userId",
          "label": "Mailbox",
          "type": "text",
          "defaultValue": "me"
        },
        {
          "key": "pollQuery",
          "label": "Poll query",
          "type": "text",
          "defaultValue": "is:unread newer_than:1d"
        },
        {
          "key": "verifyToken",
          "label": "Push verification token",
          "type": "text"
        }
      ],
      "secretFields": [
        {
          "key": "clientId",
          "label": "Client ID",
          "type": "text",
          "required": true
        },
        {
          "key": "clientSecret",
          "label": "Client secret",
          "type": "text",
          "required": true
        },
        {
          "key": "refreshToken",
          "label": "Refresh token",
          "type": "text",
          "required": true
        }
      ],
      "outbound": {
        "supported": true,
        "operations": [
          "listMessages",
          "getMessage",
          "sendMessage",
          "createDraft"
        ]
      },
      "inbound": {
        "supported": true,
        "methods": [
          "POST"
        ],
        "defaultDeliveryMode": "batch",
        "liveEvent": "enquiries",
        "verification": {
          "kind": "optional_header_token",
          "header": "X-Goog-Channel-Token",
          "configField": "verifyToken"
        },
        "idempotencyKey": {
          "mode": "composite",
          "parts": [
            "messageId",
            "historyId"
          ]
        },
        "poll": {
          "supported": true,
          "configPath": "pollQuery"
        }
      }
    },
    "google_maps": {
      "label": "Google Maps",
      "category": "geo_enrichment",
      "direction": "outbound",
      "multiInstance": true,
      "instanceRequired": true,
      "configFields": [
        {
          "key": "regionCode",
          "label": "Region code",
          "type": "text",
          "defaultValue": "IN"
        },
        {
          "key": "languageCode",
          "label": "Language",
          "type": "text",
          "defaultValue": "en"
        }
      ],
      "secretFields": [
        {
          "key": "apiKey",
          "label": "API key",
          "type": "text",
          "required": true
        }
      ],
      "outbound": {
        "supported": true,
        "operations": [
          "searchPlaces",
          "computeRoutes"
        ]
      },
      "inbound": {
        "supported": false
      }
    },
    "google_search": {
      "label": "Google Custom Search",
      "category": "search_enrichment",
      "direction": "outbound",
      "multiInstance": true,
      "instanceRequired": true,
      "configFields": [
        {
          "key": "cx",
