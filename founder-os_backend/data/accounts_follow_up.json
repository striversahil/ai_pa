{
    "schema_version": "1.0",
    "date_type_legend": {
        "not_applicable": {
            "description": "No specific date needed (e.g. Daily tasks done every working day).",
            "fields": {}
        },
        "fixed_day": {
            "description": "A single fixed day number, repeating every month unless 'month' is set.",
            "fields": {
                "day": "int (1-31)",
                "month": "string or null (null = every month)"
            }
        },
        "day_range": {
            "description": "A window between two day numbers within a month (e.g. 10 to 15).",
            "fields": {
                "start_day": "int",
                "end_day": "int",
                "month": "string or null (null = every month)"
            }
        },
        "multiple_days": {
            "description": "Several specific day numbers in the same month (e.g. 8th, 11th & 13th).",
            "fields": {
                "days": "list of int",
                "month": "string or null (null = every month)"
            }
        },
        "weekday": {
            "description": "Tied to a day of the week rather than a date (e.g. every Thursday).",
            "fields": {
                "weekday": "Monday..Sunday",
                "occurrence": "'every' | 'first' | 'last' etc."
            }
        },
        "week_of_month": {
            "description": "A relative week within a specific month (e.g. 1st week of February).",
            "fields": {
                "week_number": "int (1-5)",
                "month": "string"
            }
        },
        "month_day_range": {
            "description": "A date range that can span two different months (e.g. 30 Sept - 31 Oct).",
            "fields": {
                "start": {
                    "day": "int",
                    "month": "string"
                },
                "end": {
                    "day": "int",
                    "month": "string"
                }
            }
        },
        "multi_occurrence": {
            "description": "A list of separate date rules that all apply (e.g. quarterly dates, or a mix of week-of-month + date-range).",
            "fields": {
                "occurrences": "list of any of the other type objects"
            }
        },
        "variable_per_item": {
            "description": "Date differs per sub-item and is not a single fixed rule (e.g. each credit card has its own statement generation date).",
            "fields": {
                "note": "string explanation"
            }
        },
        "to_be_decided": {
            "description": "Expected date has not been finalised yet.",
            "fields": {}
        }
    },
